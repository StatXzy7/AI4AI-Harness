 DESC LIMIT 1;", "SELECT artist FROM cards WHERE side IS NULL ORDER BY convertedManaCost DESC LIMIT 1", "SELECT artist FROM cards WHERE side IS NULL ORDER BY convertedManaCost DESC LIMIT 1;"], "6b7df525f3bb6d0dc8365ff410e0c77cf896b6b5": ["SELECT T1.text FROM foreign_data AS T1 INNER JOIN cards AS T2 ON T1.uuid = T2.uuid INNER JOIN sets AS T3 ON T2.setCode = T3.code WHERE T3.name = 'Coldsnap' AND T1.language = 'Italian'", "SELECT foreign_data.text FROM cards JOIN foreign_data ON cards.uuid = foreign_data.uuid JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Coldsnap' AND foreign_data.language = 'Italian'", "SELECT foreign_data.text\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nJOIN foreign_data ON foreign_data.uuid = cards.uuid\nWHERE sets.name = 'Coldsnap' AND foreign_data.language = 'Italian';"], "fb038e5b1b7e45b5d86a772f8defca564a5f45a6": ["SELECT MAX(frameEffects) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL", "SELECT MAX(frameEffects) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL;", "SELECT MAX(frameEffects) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "1efe33614deda8f9c50d1dc89894b1d59c01df73": ["SELECT SUM(cards.isOnlineOnly = 1) * 100.0 / SUM(foreign_data.language = 'Portuguese (Brazil)') FROM cards JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE foreign_data.language = 'Portuguese (Brazil)';", "SELECT SUM(T1.isOnlineOnly = 1) * 100.0 / SUM(T2.language = 'Portuguese (Brazil)') FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T2.language = 'Portuguese (Brazil)'", "SELECT SUM(CASE WHEN cards.isOnlineOnly = 1 THEN 1 ELSE 0 END) * 100.0 / SUM(CASE WHEN foreign_data.language = 'Portuguese (Brazil)' THEN 1 ELSE 0 END) FROM cards JOIN foreign_data ON cards.uuid = foreign_data.uuid"], "2514101b4209cb5043ab2886019314089854e99e": ["SELECT id FROM sets WHERE type = 'commander' ORDER BY totalSetSize DESC LIMIT 1", "SELECT id FROM sets WHERE type = 'commander' ORDER BY totalSetSize DESC LIMIT 1", "SELECT id FROM sets WHERE type = 'commander' ORDER BY totalSetSize DESC LIMIT 1"], "a76d06c86b3a1f7b8069d334c1f64e18d02d648b": ["SELECT c.originalReleaseDate, l.format FROM cards c JOIN legalities l ON c.uuid = l.uuid WHERE c.rarity = 'mythic' AND c.originalReleaseDate = (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic') AND l.status = 'legal'", "SELECT c.originalReleaseDate, l.format\nFROM cards c\nJOIN legalities l ON l.uuid = c.uuid\nWHERE c.rarity = 'mythic'\n  AND c.originalReleaseDate = (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic')\n  AND l.status = 'legal'", "SELECT c.originalReleaseDate, l.format FROM cards c JOIN legalities l ON l.uuid = c.uuid WHERE c.rarity = 'mythic' AND c.originalReleaseDate = (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic') AND l.status = 'legal'"], "4d86666d04372f1360497ecebc34f97fa2afc76e": ["SELECT COUNT(DISTINCT cards.id) FROM cards JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE cards.artist = 'Volkan Ba\u01f5a' AND foreign_data.language = 'French'", "SELECT COUNT(DISTINCT c.id) FROM cards AS c JOIN foreign_data AS f ON c.uuid = f.uuid WHERE c.artist = 'Volkan Ba\u01f5a' AND f.language = 'French'", "SELECT COUNT(*) FROM cards JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE cards.artist = 'Volkan Ba\u01f5a' AND foreign_data.language = 'French'"], "9311ec1cbbac6d78dbc4a12114a67ec801108ce7": ["SELECT COUNT(*) FROM cards WHERE cards.name = 'Abundance' AND cards.rarity = 'rare' AND cards.types = 'Enchantment' AND cards.uuid IN (SELECT legalities.uuid FROM legalities GROUP BY legalities.uuid HAVING COUNT(*) = SUM(CASE WHEN legalities.status = 'Legal' THEN 1 ELSE 0 END));", "SELECT COUNT(*) FROM cards WHERE name = 'Abundance' AND rarity = 'rare' AND types = 'Enchantment' AND NOT EXISTS (SELECT 1 FROM legalities WHERE legalities.uuid = cards.uuid AND status != 'Legal');", "SELECT COUNT(*) FROM cards WHERE name = 'Abundance' AND rarity = 'rare' AND types = 'Enchantment' AND uuid NOT IN (SELECT uuid FROM legalities WHERE status != 'Legal')"], "5c7bdbb941191686ab2492ee291f89d90cffd2fe": ["SELECT cards.name FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE legalities.format = 'duel' ORDER BY cards.manaCost DESC LIMIT 10;", "SELECT T1.name\nFROM cards AS T1\nJOIN legalities AS T2 ON T1.uuid = T2.uuid\nWHERE T2.format = 'duel'\nORDER BY T1.manaCost DESC\nLIMIT 10", "SELECT T1.name FROM cards AS T1 JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T2.format = 'duel' GROUP BY T1.name ORDER BY MAX(T1.manaCost) DESC LIMIT 10"], "28b37b824884ba5bbf2a656222b8ee95a2381d1c": ["SELECT cards.name, legalities.format FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.edhrecRank = 1 AND legalities.status = 'Banned'", "SELECT c.name, l.format FROM cards c JOIN legalities l ON c.uuid = l.uuid WHERE c.edhrecRank = 1 AND l.status = 'Banned'", "SELECT c.name, l.format FROM cards c JOIN legalities l ON c.uuid = l.uuid WHERE c.edhrecRank = 1 AND l.status = 'Banned';"], "6c6b5caffda38d14625f3d66d915471307fa9d19": ["SELECT l.format, c.name\nFROM legalities l\nJOIN cards c ON l.uuid = c.uuid\nWHERE l.status = 'Banned'\n  AND l.format = (\n    SELECT format\n    FROM legalities\n    WHERE status = 'Banned'\n    GROUP BY format\n    ORDER BY COUNT(*) DESC\n    LIMIT 1\n  )", "SELECT l.format, c.name\nFROM legalities l\nJOIN cards c ON l.uuid = c.uuid\nWHERE l.status = 'Banned'\n  AND l.format = (\n    SELECT format\n    FROM legalities\n    WHERE status = 'Banned'\n    GROUP BY format\n    ORDER BY COUNT(*) DESC\n    LIMIT 1\n  );", "SELECT T1.format, T2.name FROM legalities AS T1 JOIN cards AS T2 ON T1.uuid = T2.uuid WHERE T1.status = 'Banned' AND T1.format IN (SELECT format FROM legalities WHERE status = 'Banned' GROUP BY format HAVING COUNT(*) = (SELECT MAX(cnt) FROM (SELECT COUNT(*) AS cnt FROM legalities WHERE status = 'Banned' GROUP BY format) AS sub))"], "a5bbb665b1b1b940431553441e4a9e8408ebbb76": ["SELECT uuid FROM legalities WHERE format = 'oldschool' AND status IN ('banned', 'restricted')", "SELECT DISTINCT uuid FROM legalities WHERE format = 'oldschool' AND status IN ('banned', 'restricted')", "SELECT uuid FROM legalities WHERE format = 'oldschool' AND status IN ('banned', 'restricted');"], "651e7a15d9244641615e8e8dc861785a724d044e": ["SELECT COUNT(T1.id) FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.language = 'Italian' AND T2.translation IS NOT NULL AND T1.baseSetSize < 10", "SELECT COUNT(DISTINCT T1.id) FROM sets AS T1 JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.language = 'Italian' AND T2.translation IS NOT NULL AND T1.baseSetSize < 10", "SELECT COUNT(DISTINCT T1.id) FROM sets AS T1 JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.language = 'Italian' AND T2.translation IS NOT NULL AND T1.baseSetSize < 10"], "07401180127eb432e2b595b215fd3e0b9eed1a50": ["SELECT COUNT(*) FROM cards WHERE artist = 'Matthew D. Wilson' AND availability = 'paper'", "SELECT COUNT(*) FROM cards WHERE artist = 'Matthew D. Wilson' AND availability = 'paper'", "SELECT COUNT(*) FROM cards WHERE artist = 'Matthew D. Wilson' AND availability = 'paper'"], "00a4bc15681a7c40a9f87169ea2a72e0a2a2a95d": ["SELECT T1.name, T2.format FROM cards AS T1 JOIN legalities AS T2 ON T1.uuid = T2.uuid JOIN sets AS T3 ON T1.setCode = T3.code WHERE T3.name = 'Hour of Devastation' AND T2.status = 'Legal'", "SELECT cards.name, legalities.format FROM cards JOIN sets ON cards.setCode = sets.code JOIN legalities ON cards.uuid = legalities.uuid WHERE sets.name = 'Hour of Devastation' AND legalities.status = 'Legal'", "SELECT c.name, l.format FROM cards AS c JOIN sets AS s ON c.setCode = s.code JOIN legalities AS l ON l.uuid = c.uuid WHERE s.name = 'Hour of Devastation' AND l.status = 'Legal'"], "9ec1d4e73042b9f40c9d1f08350101c0776c5a96": ["SELECT name FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Korean') AND code NOT IN (SELECT setCode FROM set_translations WHERE language = 'Japanese')", "SELECT name FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Korean') AND code NOT IN (SELECT setCode FROM set_translations WHERE language LIKE '%Japanese%')", "SELECT name FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Korean') AND code NOT IN (SELECT setCode FROM set_translations WHERE language LIKE '%Japanese%')"], "a6561c91a52ac371837800a54e54a604590e8705": ["SELECT cards.frameVersion, cards.name FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.artist = 'Allen Williams' AND legalities.status = 'Banned'", "SELECT cards.frameVersion, cards.name FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.artist = 'Allen Williams' AND legalities.status = 'Banned'", "SELECT T1.frameVersion, T1.name FROM cards AS T1 JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T1.artist = 'Allen Williams' AND T2.status = 'Banned'"], "b71c5dec4733520e1ef9db214ed419efe2dc654b": ["SELECT races.year FROM races JOIN circuits ON races.circuitId = circuits.circuitId WHERE circuits.location = 'Shanghai'", "SELECT DISTINCT r.year FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE c.location = 'Shanghai'", "SELECT DISTINCT r.year FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE c.location = 'Shanghai'"], "1a259a73b033288038d4f0160b8960008567a1ce": ["SELECT rulings.text FROM cards JOIN rulings ON cards.uuid = rulings.uuid WHERE cards.artist = 'Kev Walker' ORDER BY rulings.date DESC", "SELECT T2.text FROM cards AS T1 JOIN rulings AS T2 ON T1.uuid = T2.uuid WHERE T1.artist = 'Kev Walker' ORDER BY T2.date DESC", "SELECT T1.text FROM rulings AS T1 JOIN cards AS T2 ON T1.uuid = T2.uuid WHERE T2.artist = 'Kev Walker' GROUP BY T1.text ORDER BY MAX(T1.date) DESC"], "007049955a81d4a1e117d14d85d384e99bca6d94": ["SELECT COUNT(*) FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE r.year = 2010 AND c.country NOT IN ('Bahrain', 'China', 'India', 'Japan', 'Korea', 'Malaysia', 'Singapore', 'Turkey', 'UAE', 'Azerbaijan', 'Russia', 'Saudi Arabia', 'Qatar', 'Vietnam', 'Austria', 'Belgium', 'France', 'Germany', 'Hungary', 'Italy', 'Monaco', 'Netherlands', 'Portugal', 'Spain', 'Sweden', 'Switzerland', 'UK');", "SELECT COUNT(*) FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE r.year = 2010 AND c.country NOT IN ('Bahrain', 'Malaysia', 'China', 'Spain', 'Monaco', 'Turkey', 'Great Britain', 'Germany', 'Hungary', 'Belgium', 'Italy', 'Singapore', 'Japan', 'Korea', 'UAE');", "SELECT COUNT(*) FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE r.year = 2010 AND c.country NOT IN ('Bahrain', 'Malaysia', 'China', 'Singapore', 'Japan', 'Korea', 'India', 'UAE', 'Turkey', 'Azerbaijan', 'Russia', 'Saudi Arabia', 'Qatar', 'Vietnam', 'UK', 'Spain', 'Monaco', 'France', 'Germany', 'Hungary', 'Belgium', 'Italy', 'Austria', 'Portugal', 'Netherlands', 'Sweden', 'Switzerland');"], "8925f5ee50c05b5cd5d3ad1bccb93d0b5fbb8f37": ["SELECT DISTINCT c.lat, c.lng FROM circuits c JOIN races r ON c.circuitId = r.circuitId WHERE r.name = 'Australian Grand Prix'", "SELECT DISTINCT circuits.lat, circuits.lng FROM circuits INNER JOIN races ON circuits.circuitId = races.circuitId WHERE races.name = 'Australian Grand Prix'", "SELECT DISTINCT c.lat, c.lng FROM circuits c JOIN races r ON c.circuitId = r.circuitId WHERE r.name = 'Australian Grand Prix'"], "4a5ae02c79ef8efbd498a988aecdbd3dd2b8d158": ["SELECT DISTINCT T1.format\nFROM legalities AS T1\nJOIN cards AS T2 ON T1.uuid = T2.uuid\nWHERE T2.artist = (\n    SELECT artist\n    FROM cards\n    GROUP BY artist\n    ORDER BY COUNT(id) ASC, artist ASC\n    LIMIT 1\n)", "SELECT l.format\nFROM legalities l\nJOIN cards c ON l.uuid = c.uuid\nWHERE c.artist = (\n    SELECT artist\n    FROM cards\n    WHERE artist IS NOT NULL\n    GROUP BY artist\n    ORDER BY COUNT(*) ASC\n    LIMIT 1\n)", "SELECT T1.format FROM legalities AS T1 JOIN cards AS T2 ON T1.uuid = T2.uuid WHERE T2.artist = ( SELECT artist FROM cards GROUP BY artist ORDER BY COUNT(artist) ASC LIMIT 1 )"], "0ef8abb6ac453010e8e2daab55544d5ad0bffdd3": ["SELECT seasons.url FROM seasons JOIN races ON seasons.year = races.year WHERE races.raceId = 901", "SELECT seasons.url FROM seasons INNER JOIN races ON seasons.year = races.year WHERE races.raceId = 901", "SELECT seasons.url FROM seasons JOIN races ON seasons.year = races.year WHERE races.raceId = 901"], "41a36caf3d786070441099d4b7ba14302bf6d2da": ["SELECT T2.url FROM constructorResults AS T1 JOIN constructors AS T2 ON T1.constructorId = T2.constructorId WHERE T1.raceId = 9 ORDER BY T1.points DESC LIMIT 1", "SELECT url FROM constructors WHERE constructorId = (SELECT constructorId FROM constructorResults WHERE raceId = 9 ORDER BY points DESC LIMIT 1)", "SELECT c.url FROM constructors AS c JOIN constructorResults AS cr ON c.constructorId = cr.constructorId WHERE cr.raceId = 9 ORDER BY cr.points DESC LIMIT 1"], "4334efbe7ab7abc1e38a6b248ac4c580024d038a": ["SELECT T1.forename, T1.surname FROM drivers AS T1 JOIN results AS T2 ON T1.driverId = T2.driverId WHERE T2.raceId = 872 AND T2.time IS NOT NULL AND T2.time <> '' ORDER BY T1.dob DESC LIMIT 1", "SELECT T1.forename, T1.surname FROM drivers AS T1 INNER JOIN results AS T2 ON T1.driverId = T2.driverId WHERE T2.raceId = 872 AND T2.time IS NOT NULL AND T1.dob = (SELECT MAX(T3.dob) FROM drivers AS T3 INNER JOIN results AS T4 ON T3.driverId = T4.driverId WHERE T4.raceId = 872 AND T4.time IS NOT NULL)", "SELECT T1.forename, T1.surname FROM drivers AS T1 WHERE T1.driverId IN (SELECT T2.driverId FROM results AS T2 WHERE T2.raceId = 872 AND T2.time IS NOT NULL) AND T1.dob = (SELECT MAX(T3.dob) FROM drivers AS T3 WHERE T3.driverId IN (SELECT T4.driverId FROM results AS T4 WHERE T4.raceId = 872 AND T4.time IS NOT NULL))"], "b250a133e9aa1316e1abf2e9f0cff018bbac99ec": ["SELECT (CAST(r1.fastestLapSpeed AS REAL) - CAST(r2.fastestLapSpeed AS REAL)) * 100.0 / CAST(r1.fastestLapSpeed AS REAL) AS percentage\nFROM results r1\nJOIN results r2 ON r2.raceId = r1.raceId + 1\nJOIN drivers d ON d.driverId = r1.driverId\nWHERE d.forename = 'Paul' AND d.surname = 'di Resta'\nAND r1.raceId = 853\nAND r2.raceId = 854;", "SELECT (CAST(r1.fastestLapSpeed AS REAL) - CAST(r2.fastestLapSpeed AS REAL)) * 100.0 / CAST(r1.fastestLapSpeed AS REAL) AS percentage FROM results r1 JOIN results r2 ON r1.driverId = r2.driverId AND r2.raceId = 854 JOIN drivers d ON d.driverId = r1.driverId WHERE r1.raceId = 853 AND d.forename = 'Paul' AND d.surname = 'di Resta'", "SELECT ((CAST(r1.fastestLapSpeed AS REAL) - CAST(r2.fastestLapSpeed AS REAL)) * 100.0 / CAST(r1.fastestLapSpeed AS REAL)) FROM results r1 JOIN results r2 ON r2.raceId = 854 AND r2.driverId = r1.driverId JOIN drivers d ON d.driverId = r1.driverId WHERE r1.raceId = 853 AND d.forename = 'Paul' AND d.surname = 'di Resta'"], "322abf0d258f6194424e965c341ba31798d543cc": ["SELECT AVG(T1.milliseconds) FROM lapTimes AS T1 INNER JOIN drivers AS T2 ON T1.driverId = T2.driverId INNER JOIN races AS T3 ON T1.raceId = T3.raceId WHERE T2.forename = 'Lewis' AND T2.surname = 'Hamilton' AND T3.year = 2009 AND T3.name = 'Malaysian Grand Prix'", "SELECT AVG(lapTimes.milliseconds) FROM lapTimes JOIN drivers ON lapTimes.driverId = drivers.driverId JOIN races ON lapTimes.raceId = races.raceId WHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton' AND races.year = 2009 AND races.name = 'Malaysian Grand Prix';", "SELECT AVG(T1.milliseconds) FROM lapTimes AS T1 INNER JOIN drivers AS T2 ON T1.driverId = T2.driverId INNER JOIN races AS T3 ON T1.raceId = T3.raceId WHERE T2.forename = 'Lewis' AND T2.surname = 'Hamilton' AND T3.year = 2009 AND T3.name = 'Malaysian Grand Prix'"], "13d130aa83101d26bda8d2102fdf1a27c6c6857c": ["SELECT d.forename, d.surname, ds.points\nFROM drivers d\nJOIN driverStandings ds ON d.driverId = ds.driverId\nWHERE ds.points = (SELECT MAX(points) FROM driverStandings);", "SELECT d.forename, d.surname, MAX(ds.points) FROM drivers d JOIN driverStandings ds ON d.driverId = ds.driverId;", "SELECT d.forename, d.surname, ds.points\nFROM drivers AS d\nJOIN driverStandings AS ds ON d.driverId = ds.driverId\nWHERE ds.points = (SELECT MAX(points) FROM driverStandings);"], "8e2c66ad53bbbc8ad019ad7477b3691fde115167": ["SELECT strftime('%Y', CURRENT_TIMESTAMP) - strftime('%Y', dob) AS age, forename || ' ' || surname AS name FROM drivers WHERE nationality = 'Japanese' ORDER BY dob DESC LIMIT 1;", "SELECT CAST(strftime('%Y', 'now') AS INTEGER) - CAST(strftime('%Y', dob) AS INTEGER) AS age, forename, surname FROM drivers WHERE nationality = 'Japanese' ORDER BY dob DESC LIMIT 1", "SELECT strftime('%Y','now') - strftime('%Y', dob) AS age, forename || ' ' || surname AS name FROM drivers WHERE nationality = 'Japanese' ORDER BY dob DESC LIMIT 1"], "41581ec463e83e11f2a335d3c8d71faacc861f46": ["SELECT COUNT(DISTINCT r.driverId) FROM results r JOIN races ra ON r.raceId = ra.raceId WHERE ra.year = 2008 AND ra.name = 'Australian Grand Prix' AND r.time IS NOT NULL;", "SELECT COUNT(DISTINCT T1.driverId) FROM results AS T1 INNER JOIN races AS T2 ON T1.raceId = T2.raceId WHERE T2.year = 2008 AND T2.name = 'Australian Grand Prix' AND T1.time IS NOT NULL", "SELECT COUNT(DISTINCT driverId) FROM results WHERE raceId = (SELECT raceId FROM races WHERE year = 2008 AND name = 'Australian Grand Prix') AND time IS NOT NULL"], "1f764d526cd6aa31bfd23fdbfcc6826a6d395d67": ["SELECT CAST(COUNT(CASE WHEN r.position > 1 THEN r.raceId END) AS REAL) / COUNT(r.raceId)\nFROM results AS r\nJOIN drivers AS d ON d.driverId = r.driverId\nJOIN races AS ra ON ra.raceId = r.raceId\nWHERE d.surname = 'Hamilton' AND ra.year >= 2010;", "SELECT CAST(SUM(CASE WHEN r.position > 1 THEN 1 ELSE 0 END) AS REAL) / COUNT(r.raceId) AS percentage\nFROM results r\nJOIN drivers d ON r.driverId = d.driverId\nJOIN races ra ON r.raceId = ra.raceId\nWHERE d.surname = 'Hamilton' AND ra.year >= 2010;", "SELECT 100.0 * SUM(CASE WHEN r.position > 1 THEN 1 ELSE 0 END) / COUNT(r.raceId) AS percentage FROM results r JOIN drivers d ON r.driverId = d.driverId JOIN races ra ON r.raceId = ra.raceId WHERE d.surname = 'Hamilton' AND ra.year >= 2010"], "be14bebea2d57f2b014dbe949613ecf52a81f371": ["SELECT AVG(\n    CAST(SUBSTR(r.fastestLapTime, 1, INSTR(r.fastestLapTime, ':') - 1) AS INTEGER) * 60\n    + CAST(SUBSTR(r.fastestLapTime, INSTR(r.fastestLapTime, ':') + 1, INSTR(r.fastestLapTime, '.') - INSTR(r.fastestLapTime, ':') - 1) AS INTEGER)\n    + CAST(SUBSTR(r.fastestLapTime, INSTR(r.fastestLapTime, '.') + 1) AS REAL) / 1000.0\n) AS avg_fastest_lap_seconds\nFROM results r\nJOIN drivers d ON r.driverId = d.driverId\nWHERE d.forename = 'Lewis' AND d.surname = 'Hamilton'\n  AND r.fastestLapTime IS NOT NULL\n  AND r.fastestLapTime != ''\n  AND r.fastestLapTime != '\\\\N';", "SELECT AVG(\n    CAST(SUBSTR(r.fastestLapTime, 1, INSTR(r.fastestLapTime, ':') - 1) AS REAL) * 60 +\n    CAST(SUBSTR(r.fastestLapTime, INSTR(r.fastestLapTime, ':') + 1) AS REAL)\n) AS avg_fastest_lap_seconds\nFROM results r\nJOIN drivers d ON r.driverId = d.driverId\nWHERE d.forename = 'Lewis' AND d.surname = 'Hamilton'\n  AND r.fastestLapTime IS NOT NULL;", "SELECT AVG(\n    CAST(substr(r.fastestLapTime, 1, instr(r.fastestLapTime, ':') - 1) AS REAL) * 60 +\n    CAST(substr(r.fastestLapTime, instr(r.fastestLapTime, ':') + 1) AS REAL)\n) AS average_fastest_lap_seconds\nFROM results r\nJOIN drivers d ON r.driverId = d.driverId\nWHERE d.forename = 'Lewis' AND d.surname = 'Hamilton'\n  AND r.fastestLapTime IS NOT NULL;"], "e45af1d6c8ff7856224e13789288edbd10c69e89": ["SELECT COUNT(*) FROM drivers WHERE driverId IN (SELECT driverId FROM results WHERE raceId = (SELECT raceId FROM races WHERE year = 2008 AND name = 'Chinese Grand Prix') AND time IS NOT NULL) AND driverId IN (SELECT driverId FROM results GROUP BY driverId HAVING COUNT(raceId) > 0)", "SELECT COUNT(*) FROM drivers WHERE driverId IN (SELECT driverId FROM results WHERE time IS NOT NULL AND raceId = (SELECT raceId FROM races WHERE year = 2008 AND name = 'Chinese Grand Prix')) AND driverId IN (SELECT driverId FROM results GROUP BY driverId HAVING COUNT(raceId) > 0)", "SELECT COUNT(*) FROM drivers WHERE driverId IN (SELECT driverId FROM results WHERE time IS NOT NULL AND raceId = (SELECT raceId FROM races WHERE year = 2008 AND name = 'Chinese Grand Prix')) AND driverId IN (SELECT driverId FROM results WHERE raceId > 0)"], "35e1b0891a05fe0f2b5d174763353895edde0c28": ["SELECT AVG(CAST(fastestLapSpeed AS REAL)) FROM results JOIN races ON results.raceId = races.raceId WHERE races.name = 'Spanish Grand Prix' AND races.year = 2009;", "SELECT AVG(r.fastestLapSpeed) FROM results r JOIN races ra ON r.raceId = ra.raceId WHERE ra.name = 'Spanish Grand Prix' AND ra.year = 2009;", "SELECT AVG(CAST(fastestLapSpeed AS REAL)) FROM results INNER JOIN races ON results.raceId = races.raceId WHERE races.name = 'Spanish Grand Prix' AND races.year = 2009;"], "c4cdbe6fff6f7270a106d1ebbf496252bda52ed3": ["SELECT CAST(COUNT(CASE WHEN results.time IS NOT NULL THEN results.driverId END) AS REAL) / COUNT(results.driverId) * 100 AS percentage\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE drivers.nationality = 'Japanese' AND races.year BETWEEN 2007 AND 2009;", "SELECT SUM(CASE WHEN results.time IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(results.driverId) AS completion_percentage\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE drivers.nationality = 'Japanese' AND races.year BETWEEN 2007 AND 2009;", "SELECT CAST(COUNT(CASE WHEN results.time IS NOT NULL THEN 1 END) AS REAL) * 100 / COUNT(results.driverId)\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.year BETWEEN 2007 AND 2009 AND drivers.nationality = 'Japanese'"], "e3d9bb67447d131328fb1ef04b562b2af38c06ff": ["SELECT COUNT(DISTINCT T1.driverId) FROM drivers AS T1 INNER JOIN lapTimes AS T2 ON T1.driverId = T2.driverId WHERE T1.nationality = 'French' AND T2.milliseconds < 120000", "SELECT COUNT(DISTINCT T1.driverId) FROM drivers AS T1 JOIN lapTimes AS T2 ON T1.driverId = T2.driverId WHERE T1.nationality = 'French' AND T2.milliseconds < 120000", "SELECT COUNT(DISTINCT T1.driverId) FROM drivers AS T1 INNER JOIN lapTimes AS T2 ON T1.driverId = T2.driverId WHERE T1.nationality = 'French' AND T2.milliseconds < 120000"], "2ed24b53427703455664f2ce21bf9c86ce9e165b": ["SELECT COUNT(*) FROM drivers WHERE nationality = 'British' AND strftime('%Y', dob) = '1980';", "SELECT COUNT(*) FROM drivers WHERE nationality = 'British' AND strftime('%Y', dob) = '1980';", "SELECT COUNT(*) FROM drivers WHERE nationality = 'British' AND strftime('%Y', dob) = '1980'"], "2ca025a67c1fdf5b794448288e1ca43fb3f1f95f": ["SELECT r.year, r.name, r.date, r.time\nFROM races r\nJOIN qualifying q ON q.raceId = r.raceId\nWHERE q.driverId = (SELECT driverId FROM drivers ORDER BY dob DESC LIMIT 1)\nORDER BY r.date ASC\nLIMIT 1;", "SELECT r.year, r.name, r.date, r.time\nFROM races r\nJOIN qualifying q ON q.raceId = r.raceId\nWHERE q.driverId IN (\n    SELECT driverId\n    FROM drivers\n    WHERE dob = (SELECT MAX(dob) FROM drivers)\n)\nORDER BY r.date ASC\nLIMIT 1;", "SELECT r.year, r.name, r.date, r.time\nFROM races r\nJOIN qualifying q ON q.raceId = r.raceId\nJOIN drivers d ON d.driverId = q.driverId\nWHERE d.dob = (SELECT MAX(dob) FROM drivers)\nORDER BY r.date ASC\nLIMIT 1"], "2e9c05146fa5a476a690066058dc3cd12dba2adc": ["SELECT SUM(CASE WHEN convertedManaCost = 10 THEN 1 ELSE 0 END) * 100.0 / COUNT(convertedManaCost) FROM cards WHERE setCode = (SELECT setCode FROM cards WHERE name = 'Abyssal Horror' LIMIT 1)"], "1773c1d49bfa7f8cacfe5353ea148bba48564269": ["SELECT COUNT(races.raceId), circuits.location, circuits.lat, circuits.lng FROM circuits JOIN races ON circuits.circuitId = races.circuitId WHERE circuits.country = 'Austria' GROUP BY circuits.circuitId, circuits.location, circuits.lat, circuits.lng;", "SELECT c.location, c.lat, c.lng, COUNT(r.raceId) AS times_held\nFROM circuits c\nJOIN races r ON c.circuitId = r.circuitId\nWHERE c.country = 'Austria'\nGROUP BY c.circuitId, c.location, c.lat, c.lng", "SELECT c.location, c.lat, c.lng, COUNT(r.raceId) AS times_held\nFROM circuits c\nJOIN races r ON c.circuitId = r.circuitId\nWHERE c.country = 'Austria'\nGROUP BY c.circuitId, c.location, c.lat, c.lng;"], "2cb0f4009dbca2ebc016c94683eb3f5042508919": ["SELECT c.constructorRef, c.url\nFROM constructors c\nJOIN results r ON c.constructorId = r.constructorId\nJOIN races ra ON r.raceId = ra.raceId\nWHERE ra.name = 'Singapore Grand Prix'\n  AND ra.year = 2009\n  AND r.time LIKE '%:%.%'\n  AND r.time = (\n      SELECT MAX(r2.time)\n      FROM results r2\n      JOIN races ra2 ON r2.raceId = ra2.raceId\n      WHERE ra2.name = 'Singapore Grand Prix'\n        AND ra2.year = 2009\n        AND r2.time LIKE '%:%.%'\n  );", "SELECT c.constructorRef, c.url\nFROM constructors c\nWHERE c.constructorId = (\n    SELECT r.constructorId\n    FROM results r\n    JOIN races ra ON ra.raceId = r.raceId\n    WHERE ra.name = 'Singapore Grand Prix' AND ra.year = 2009\n    ORDER BY r.time DESC\n    LIMIT 1\n);", "SELECT T1.constructorRef, T1.url\nFROM constructors AS T1\nJOIN results AS T2 ON T1.constructorId = T2.constructorId\nJOIN races AS T3 ON T2.raceId = T3.raceId\nWHERE T3.year = 2009 AND T3.name = 'Singapore Grand Prix'\n  AND T2.time = (\n      SELECT MAX(T4.time)\n      FROM results AS T4\n      JOIN races AS T5 ON T4.raceId = T5.raceId\n      WHERE T5.year = 2009 AND T5.name = 'Singapore Grand Prix'\n  );"], "d9993623cd3443ff34594fa5c98a4136b21e7102": ["SELECT SUM(T1.points) AS score, T3.name, T3.nationality FROM results AS T1 INNER JOIN races AS T2 ON T1.raceId = T2.raceId INNER JOIN constructors AS T3 ON T1.constructorId = T3.constructorId WHERE T2.name = 'Monaco Grand Prix' AND T2.year BETWEEN 1980 AND 2010 GROUP BY T1.constructorId ORDER BY score DESC LIMIT 1", "SELECT SUM(results.points) AS score, constructors.name, constructors.nationality\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN constructors ON results.constructorId = constructors.constructorId\nWHERE races.name = 'Monaco Grand Prix' AND races.year BETWEEN 1980 AND 2010\nGROUP BY constructors.constructorId\nORDER BY score DESC\nLIMIT 1;", "SELECT SUM(T1.points) AS score, T3.name, T3.nationality\nFROM constructorResults AS T1\nJOIN races AS T2 ON T1.raceId = T2.raceId\nJOIN constructors AS T3 ON T1.constructorId = T3.constructorId\nWHERE T2.name = 'Monaco Grand Prix' AND T2.year BETWEEN 1980 AND 2010\nGROUP BY T1.constructorId\nORDER BY score DESC\nLIMIT 1;"], "915c6a8b1f7d5cfa3d5594d54204ae0adaaf7d72": ["SELECT T1.forename, T1.surname, T1.nationality, MAX(T2.points) FROM drivers AS T1 JOIN driverStandings AS T2 ON T1.driverId = T2.driverId GROUP BY T2.driverId ORDER BY COUNT(T2.wins) DESC LIMIT 1", "SELECT d.forename, d.surname, d.nationality, MAX(ds.points)\nFROM drivers AS d\nJOIN driverStandings AS ds ON d.driverId = ds.driverId\nGROUP BY d.driverId, d.forename, d.surname, d.nationality\nORDER BY MAX(ds.wins) DESC\nLIMIT 1;", "SELECT d.forename, d.surname, d.nationality, MAX(ds.points) AS max_points\nFROM drivers AS d\nJOIN driverStandings AS ds ON d.driverId = ds.driverId\nGROUP BY d.driverId\nORDER BY COUNT(ds.wins) DESC\nLIMIT 1;"], "248000d136903187654209d79e3d0d372453b1f9": ["SELECT d.forename || ' ' || d.surname AS full_name, d.nationality, r.name\nFROM drivers d\nJOIN results res ON res.driverId = d.driverId\nJOIN races r ON r.raceId = res.raceId\nWHERE d.dob = (SELECT MAX(dob) FROM drivers)\nORDER BY r.date ASC\nLIMIT 1;", "SELECT d.forename || ' ' || d.surname AS full_name, d.nationality, r.name AS race_name\nFROM drivers d\nJOIN results res ON res.driverId = d.driverId\nJOIN races r ON r.raceId = res.raceId\nWHERE d.dob = (SELECT MAX(dob) FROM drivers)\nORDER BY r.date, r.round\nLIMIT 1;", "SELECT d.forename || ' ' || d.surname AS full_name, d.nationality, r.name\nFROM drivers d\nJOIN results res ON d.driverId = res.driverId\nJOIN races r ON res.raceId = r.raceId\nWHERE d.dob = (SELECT MAX(dob) FROM drivers)\nORDER BY r.date ASC\nLIMIT 1;"], "65f715c4b5e1f0623c2e2f9f450c0cf5f8d76048": ["SELECT d.forename, d.surname FROM drivers d WHERE d.driverId = (SELECT q.driverId FROM qualifying q WHERE q.raceId = (SELECT r.raceId FROM races r JOIN circuits c ON r.circuitId = c.circuitId WHERE c.name = 'Marina Bay Street Circuit' AND r.year = 2008) ORDER BY q.q3 ASC LIMIT 1)", "SELECT d.forename, d.surname FROM drivers d JOIN qualifying q ON q.driverId = d.driverId JOIN races r ON r.raceId = q.raceId JOIN circuits c ON c.circuitId = r.circuitId WHERE c.name = 'Marina Bay Street Circuit' AND r.year = 2008 AND q.q3 = (SELECT MIN(q2.q3) FROM qualifying q2 JOIN races r2 ON r2.raceId = q2.raceId JOIN circuits c2 ON c2.circuitId = r2.circuitId WHERE c2.name = 'Marina Bay Street Circuit' AND r2.year = 2008)", "SELECT d.forename, d.surname\nFROM drivers d\nJOIN qualifying q ON d.driverId = q.driverId\nJOIN races r ON q.raceId = r.raceId\nJOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.name = 'Marina Bay Street Circuit'\n  AND r.year = 2008\n  AND q.q3 = (SELECT MIN(q3) FROM qualifying WHERE raceId = r.raceId);"], "fc2fd6383ca7f541442d7d3bcbc83eb2db75e1c4": ["SELECT c.name AS circuit, MIN(res.fastestLapTime) AS lap_record\nFROM circuits c\nJOIN races r ON r.circuitId = c.circuitId\nJOIN results res ON res.raceId = r.raceId\nWHERE c.country = 'Italy' AND res.fastestLapTime IS NOT NULL\nGROUP BY c.circuitId;", "SELECT c.name, lt.time AS lap_record\nFROM lapTimes lt\nJOIN races r ON lt.raceId = r.raceId\nJOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.country = 'Italy'\n  AND lt.milliseconds = (\n      SELECT MIN(lt2.milliseconds)\n      FROM lapTimes lt2\n      JOIN races r2 ON lt2.raceId = r2.raceId\n      WHERE r2.circuitId = c.circuitId\n  )", "SELECT c.name,\n       (SELECT l.time\n        FROM lapTimes l\n        JOIN races r ON l.raceId = r.raceId\n        WHERE r.circuitId = c.circuitId\n        ORDER BY l.milliseconds ASC\n        LIMIT 1) AS lap_record\nFROM circuits c\nWHERE c.country = 'Italy';"], "13281cb48f109994b4faf7b0273b0e4d05c68b37": ["SELECT time FROM lapTimes ORDER BY milliseconds ASC LIMIT 1", "SELECT time FROM lapTimes ORDER BY milliseconds ASC LIMIT 1;", "SELECT time FROM lapTimes ORDER BY milliseconds ASC LIMIT 1;"], "2a21890d09882ff48d4c6b754726924d3eeed1af": ["SELECT AVG(lt.milliseconds) FROM lapTimes AS lt JOIN races AS r ON lt.raceId = r.raceId JOIN circuits AS c ON r.circuitId = c.circuitId WHERE c.country = 'Italy';", "SELECT AVG(lt.milliseconds) FROM lapTimes lt JOIN races r ON lt.raceId = r.raceId JOIN circuits c ON r.circuitId = c.circuitId WHERE c.country = 'Italy'", "SELECT AVG(lt.milliseconds) FROM lapTimes lt JOIN races r ON lt.raceId = r.raceId JOIN circuits c ON r.circuitId = c.circuitId WHERE c.country = 'Italy'"], "0e07ca090666592274d14bda49b710fb175b812d": ["SELECT T1.time\nFROM lapTimes AS T1\nINNER JOIN races AS T2 ON T1.raceId = T2.raceId\nWHERE T2.name = 'Austrian Grand Prix'\nORDER BY T1.milliseconds ASC\nLIMIT 1", "SELECT lt.time FROM lapTimes lt JOIN races r ON lt.raceId = r.raceId JOIN circuits c ON r.circuitId = c.circuitId WHERE c.name LIKE '%Austrian%' OR r.name = 'Austrian Grand Prix' ORDER BY lt.milliseconds ASC LIMIT 1;", "SELECT lt.time\nFROM lapTimes lt\nJOIN races r ON lt.raceId = r.raceId\nJOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.name = 'Austrian Grand Prix Circuit'\nORDER BY lt.milliseconds ASC\nLIMIT 1;"], "7eb6ca0df5ec83e9d73ac391e459aa75f0f18e45": ["SELECT T2.translation FROM cards AS T1 JOIN set_translations AS T2 ON T1.setCode = T2.setCode WHERE T1.name = 'Tendo Ice Bridge' AND T2.language = 'French'"], "6474e69b1861b2cbd4a97981991e6540410970b5": ["SELECT CAST(COUNT(CASE WHEN convertedManaCost = 10 THEN 1 END) AS REAL) * 100 / COUNT(convertedManaCost) FROM cards WHERE setCode = (SELECT setCode FROM cards WHERE name = 'Abyssal Horror')"], "07e71478708df282c9aeb615c7814a9b174b082c": ["SELECT translation FROM set_translations WHERE language = 'French' AND setCode IN (SELECT setCode FROM cards WHERE name = 'Tendo Ice Bridge');"], "363525a0e3097f727568c3c91bed60d14a585f42": ["SELECT r.name FROM races r JOIN circuits c ON r.circuitId = c.circuitId JOIN lapTimes lt ON lt.raceId = r.raceId WHERE c.name = 'Austrian Grand Prix Circuit' ORDER BY lt.milliseconds ASC LIMIT 1", "SELECT r.name, r.year FROM races r JOIN circuits c ON r.circuitId = c.circuitId JOIN lapTimes lt ON lt.raceId = r.raceId WHERE c.country = 'Austria' ORDER BY lt.milliseconds ASC LIMIT 1", "SELECT races.name, races.year\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nJOIN lapTimes ON lapTimes.raceId = races.raceId\nWHERE circuits.name = 'Austrian Grand Prix Circuit'\nORDER BY lapTimes.milliseconds ASC\nLIMIT 1"], "f703da5c749736ae165b0e9278f519a32ddf80b9": ["SELECT translation FROM set_translations WHERE setCode = (SELECT setCode FROM cards WHERE name = 'Tendo Ice Bridge') AND language = 'French';"], "997d8512454298a11223e1b99211e18dc5d10089": ["SELECT AVG(T1.id), T2.language FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T1.releaseDate BETWEEN '2012-01-01' AND '2015-12-31' GROUP BY T2.language ORDER BY COUNT(T2.language) DESC LIMIT 1"], "437cfa576aec466e748baa4b17e5a15974a3238d": ["SELECT CAST(SUM(CASE WHEN convertedManaCost = 16 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(convertedManaCost) FROM cards WHERE setCode IN (SELECT setCode FROM cards WHERE name = 'Abyssal Horror')"], "b2c6f679e7d85d7bc246f16a4cbf90f155255530": ["SELECT AVG(T1.id), T2.language FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE STRFTIME('%Y', T1.releaseDate) BETWEEN '2012' AND '2015' GROUP BY T2.language ORDER BY COUNT(T2.language) DESC LIMIT 1"], "621e4e6b7ea204f05fb18fc45f8ddf406a733b3f": ["SELECT DISTINCT name FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "13028e0bd066eb2c390dcda3746679eb90812163": ["SELECT cards.name FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.rarity = 'mythic' AND legalities.status = 'Banned' AND legalities.format = 'gladiator'"], "9a8b935eae3f647d3cd1426b4710930932fad729": ["SELECT rulings.text FROM cards INNER JOIN rulings ON cards.uuid = rulings.uuid WHERE cards.name = 'Sublime Epiphany' AND cards.number = '74s'"], "a8838572d112048fe4b5f2bffd7029a0fa2d0e9a": ["SELECT legalities.status FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.types = 'Artifact' AND cards.side IS NULL AND legalities.format = 'vintage'"], "e048cd68a8fe7fc6d243b4a96c112dc80beddb0f": ["SELECT name FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "ad026342d7563755c7847bef8b82bacd780dfd6d": ["SELECT name FROM cards WHERE rarity = 'mythic' AND uuid IN (SELECT uuid FROM legalities WHERE status = 'Banned' AND format = 'gladiator')"], "3879cbe840641bf0b02317a7649935de08880eb9": ["SELECT cards.id, rulings.text, cards.hasContentWarning\nFROM cards\nINNER JOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.artist = 'Stephen Daniele'"], "6ca81de4b4b9a01a641a308c7e7b49826e83a6fa": ["SELECT cards.id, cards.artist\nFROM cards\nINNER JOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.format = 'commander'\n  AND legalities.status = 'Legal'\n  AND (cards.power = '*' OR cards.power IS NULL)"], "05476f8f06e26901e9fba63dde50a92e24ccbda2": ["SELECT text FROM rulings WHERE uuid IN (SELECT uuid FROM cards WHERE name = 'Sublime Epiphany' AND number = '74s')"], "fd3f5f172390726b13a7d406d8cf2db5c3b5ba67": ["SELECT cards.borderColor FROM cards WHERE cards.name = 'Ancestor''s Chosen'"], "31eceafb43359dde3fa8d5176ab7e8e0ae30b371": ["SELECT id, artist FROM cards WHERE (power = '*' OR power IS NULL) AND uuid IN (SELECT uuid FROM legalities WHERE format = 'commander' AND status = 'Legal')"], "58a4e4be5b15b765f73ae4d44ca8c5dba3db22e8": ["SELECT status FROM legalities WHERE format = 'vintage' AND uuid IN (SELECT uuid FROM cards WHERE types = 'Artifact' AND side IS NULL)"], "29ae1720d2e662512e2450b7f6b58e53e13ac91d": ["SELECT T2.format, T2.status\nFROM cards AS T1\nINNER JOIN legalities AS T2 ON T1.uuid = T2.uuid\nWHERE T1.name = 'Benalish Knight'"], "90a79451bbc318656d7d72aa3c9c494412eb4205": ["SELECT DISTINCT st.language\nFROM cards c\nJOIN sets s ON c.setCode = s.code\nJOIN set_translations st ON st.setCode = s.code\nWHERE c.name = 'Angel of Mercy'"], "7c3ce54cd66aa528c13b58fe26d5db0a43fd2961": ["SELECT borderColor FROM cards WHERE uuid IN (SELECT uuid FROM cards WHERE name = 'Ancestor''s Chosen')"], "68d278727cf34f184a1b048b6ff3f90a40aaf264": ["SELECT (SELECT c.id FROM cards c WHERE c.uuid = r.uuid) AS id, r.text, (SELECT c.hasContentWarning FROM cards c WHERE c.uuid = r.uuid) AS hasContentWarning FROM rulings r WHERE r.uuid IN (SELECT uuid FROM cards WHERE artist = 'Stephen Daniele')"], "8d4fd6a75a2f77ab1dab2606dc395cfd6b47638b": ["SELECT COUNT(*) FROM cards WHERE toughness = '99'"], "330304cd14fea1335e1cb30f5fd9aff0036a90f1": ["SELECT format FROM legalities WHERE uuid IN (SELECT uuid FROM cards WHERE name = 'Benalish Knight')"], "1f99e805ccf1fd73e0e4c87f46dfa9500e055aed": ["SELECT rulings.text FROM cards INNER JOIN rulings ON cards.uuid = rulings.uuid WHERE cards.name = 'Condemn'"], "184fa5063680a1cc61166e9a5eb2d878a0e2c87b": ["SELECT DISTINCT language FROM set_translations WHERE setCode IN (SELECT setCode FROM cards WHERE name = 'Angel of Mercy')"], "6163c18a94517f76f858c98584815d09348b754e": ["SELECT COUNT(*) FROM cards WHERE toughness = '99'"], "4e2db64af73a040c9e667f61db17b624a37141c2": ["SELECT id FROM cards WHERE duelDeck = 'a'"], "b0d9d3db02344949cd556d5a6a994015410c6b4c": ["SELECT DISTINCT layout FROM cards WHERE keywords LIKE '%flying%'"], "d0306a56b622d59e1f94f71f623e50883e0f5427": ["SELECT SUM(CASE WHEN foreign_data.language = 'Chinese Simplified' THEN 1 ELSE 0 END) * 100.0 / COUNT(foreign_data.id) FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid"], "4c618f64fb3faefcf488b596ed9fea5b2da27183": ["SELECT text FROM rulings WHERE uuid IN (SELECT uuid FROM cards WHERE name = 'Condemn')"], "652ae5152a65d23517858ebb4258100956233edf": ["SELECT id FROM cards WHERE duelDeck = 'a'"], "7f9721b93649cd6cc403a136348d215def3e04c2": ["SELECT layout FROM cards WHERE uuid IN (SELECT uuid FROM cards WHERE keywords LIKE '%flying%')"], "cce0b8c10048be180ab5db93ab71320822ff4a2f": ["SELECT SUM(CASE WHEN fd.language = 'French' THEN 1 ELSE 0 END) * 100.0 / COUNT(c.id) FROM cards c LEFT JOIN foreign_data fd ON fd.uuid = c.uuid AND fd.language = 'French' WHERE c.isStorySpotlight = 1"], "f6efa83f675ed766f2746efc014a10c1a61cf639": ["SELECT DISTINCT cards.artist FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE foreign_data.language = 'Chinese Simplified'"], "610f4e3fabb1ceb44d331fa892d28e4e9790feae": ["SELECT cards.name, cards.colors\nFROM cards\nINNER JOIN sets ON cards.setCode = sets.code\nWHERE sets.code = 'OGW'"], "37fbb4d4c14b058f5e1e664268efcd179d9355e5": ["SELECT (SELECT COUNT(*) FROM cards WHERE isStorySpotlight = 1 AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'French')) * 100.0 / (SELECT COUNT(*) FROM cards WHERE isStorySpotlight = 1)"], "a5c6dbf90cac5fcb50525997ed3dc33f024fe2b4": ["SELECT DISTINCT artist FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Chinese Simplified')"], "3407378ad204f1947f7a71986fedb76fba84e9d2": ["SELECT (SELECT COUNT(id) FROM foreign_data WHERE language = 'Chinese Simplified') * 100.0 / (SELECT COUNT(id) FROM foreign_data) AS percentage"], "0430eaded27d71e7161dae5709bc6ed894a4cc83": ["SELECT name, colors FROM cards WHERE setCode IN (SELECT code FROM sets WHERE code = 'OGW')"], "84c86fd35ffeb80ffe868ad73feb1f2f39d85380": ["SELECT DISTINCT cards.name FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE cards.originalType = 'Artifact' AND cards.colors = 'B'"], "049aef4d3d43b4302ba2deff9fef7e6066c2b1b2": ["SELECT COUNT(*) FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE legalities.status = 'Banned' AND cards.borderColor = 'white'"], "1ba1bcf830259fc14638e7fc441593f1fddcb5b5": ["SELECT COUNT(*) FROM cards WHERE borderColor = 'white' AND cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "64d20c0adc54f0668bac9c89c2ba03480a65252e": ["SELECT manaCost FROM cards WHERE layout = 'normal' AND frameVersion = '2003' AND borderColor = 'black' AND availability = 'mtgo,paper'"], "1dff91fe3147bdcd090dd492552aa2719f31faed": ["SELECT manaCost FROM cards WHERE uuid IN (SELECT uuid FROM cards WHERE layout = 'normal' AND frameVersion = '2003' AND borderColor = 'black' AND availability = 'mtgo,paper')"], "31610d1ad550411b204f54edf629560fc870c15e": ["SELECT COUNT(*) FROM cards WHERE borderColor = 'white' AND uuid IN (SELECT uuid FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL)"], "3fb2d4fb299d4ed03076f8048c5728c66e19876c": ["SELECT name FROM cards WHERE originalType = 'Artifact' AND colors = 'B' AND uuid IN (SELECT uuid FROM foreign_data)"], "03d49141cf624a4f4dc9bfaf4ebcd524614518c3": ["SELECT COUNT(*) FROM cards WHERE borderColor = 'white' AND uuid IN (SELECT uuid FROM legalities WHERE status = 'Banned')"], "a071bc7daa9d432691eb58f58cb50b6061811bf8": ["SELECT DISTINCT cards.name\nFROM cards\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.availability = 'paper'\n  AND foreign_data.language = 'Japanese'"], "f1a97718465f4c099311a4afbd8de56db9a41b93": ["SELECT DISTINCT subtypes, supertypes FROM cards WHERE availability = 'arena'"], "c36a3f5f35535bd39132bf5936bc0395c363c6f1": ["SELECT COUNT(*) FROM cards WHERE artist = 'John Avon' AND (cardKingdomId IS NULL OR cardKingdomFoilId IS NULL)"], "59a677bccd769f49b19dfb313338137afe85d8f3": ["SELECT subtypes, supertypes FROM cards WHERE availability = 'arena'"], "08382f4a3b4e1af81ce466c747aa1e97e1b647fc": ["SELECT name FROM cards WHERE availability = 'paper' AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Japanese')"], "222a520d0fb38465580faf8c579167647d0a5e05": ["SELECT DISTINCT T1.language FROM set_translations AS T1 INNER JOIN sets AS T2 ON T1.setCode = T2.code WHERE T2.baseSetSize = 309"], "2a81b8408b26187c6199099bea8b2387fcd95027": ["SELECT COUNT(*) FROM sets INNER JOIN set_translations ON sets.code = set_translations.setCode WHERE sets.block = 'Commander' AND set_translations.language = 'Portuguese (Brasil)'"], "fbe291fa984bdad792738a6427f9f80fbcb4970e": ["SELECT T1.setCode FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T2.language = 'Spanish'"], "775fc53adea447baf439fe2b1c5968617008e2d6": ["SELECT COUNT(*) FROM sets WHERE block = 'Commander' AND code IN (SELECT setCode FROM set_translations WHERE language = 'Portuguese (Brasil)')"], "8a4f76e9560b4024a4db54c9d9a338aafef81348": ["SELECT DISTINCT language FROM set_translations WHERE setCode IN (SELECT code FROM sets WHERE baseSetSize = 309)"], "96373c3fa435181b26ad288495fedf5884ce30de": ["SELECT CAST(SUM(CASE WHEN isOnlineOnly = 1 THEN 1 ELSE 0 END) AS REAL) / COUNT(id) FROM cards WHERE frameEffects = 'legendary'"], "8da2365bc919a82227acdafa442b3d0391e72f57": ["SELECT cards.id FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.types = 'Creature' AND legalities.status = 'legal'"], "dac3207eb8e32ee649eaf684488a51d95d8d5e96": ["SELECT (SELECT COUNT(*) FROM cards WHERE frameEffects = 'legendary' AND isOnlineOnly = 1) * 100.0 / (SELECT COUNT(*) FROM cards WHERE frameEffects = 'legendary') AS percentage"], "f744e5f060015c17ef4f95f8ced02f6187f438ac": ["SELECT setCode FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Spanish')"], "bba585b61d75e66d246aa7d02900ce9ecf6da1b4": ["SELECT COUNT(*) FROM cards WHERE (power IS NULL OR power = '*') AND text LIKE '%triggered ability%'"], "1fd705b36a574285242f6434d2f67e3ec77f70a8": ["SELECT DISTINCT c.subtypes, c.supertypes\nFROM cards c\nJOIN foreign_data fd ON c.uuid = fd.uuid\nWHERE fd.language = 'German'\n  AND c.subtypes IS NOT NULL\n  AND c.supertypes IS NOT NULL"], "a22de39361d7d65113e2b8a6cf70853df1bf544a": ["SELECT COUNT(*) FROM cards WHERE (power IS NULL OR power = '*') AND text LIKE '%triggered ability%'"], "c4b6f5eee34943cb65f461fd445161606f2da178": ["SELECT COUNT(*) FROM cards WHERE artist = 'John Avon' AND cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NULL"], "62ccc64df624e3811db859b6819b2c740ddb04f4": ["SELECT COUNT(DISTINCT cards.id) FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid INNER JOIN rulings ON cards.uuid = rulings.uuid WHERE legalities.format = 'premodern' AND rulings.text = 'This is a triggered mana ability.' AND cards.side IS NULL"], "bc7fa233957ea484d46e538fcebcded9eb82d1a9": ["SELECT cards.artist FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE foreign_data.flavorText = 'Das perfekte Gegenmittel zu einer dichten Formation'"], "dae1af6fe8ce3406b6b5a77bb124c2ffc74be49a": ["SELECT subtypes, supertypes FROM cards WHERE subtypes IS NOT NULL AND supertypes IS NOT NULL AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'German')"], "bc308ac12c40920ef89507f0cd3a7f21c6ecbca0": ["SELECT cards.id FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.artist = 'Erica Yang' AND legalities.format = 'pauper' AND legalities.status = 'Legal' AND cards.availability = 'paper'"], "a6521709744c81bd6e0e16598f1bcc1b1e7ef60a": ["SELECT artist FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE flavorText = 'Das perfekte Gegenmittel zu einer dichten Formation')"], "82fdc8ca843cbbea1a94e6f5194df5217ea7426e": ["SELECT COUNT(DISTINCT name) FROM cards WHERE side IS NULL AND uuid IN (SELECT uuid FROM legalities WHERE format = 'premodern') AND uuid IN (SELECT uuid FROM rulings WHERE text = 'This is a triggered mana ability.')"], "379c6e32817840ad1b78c5a7949bc35fbc956fcf": ["SELECT foreign_data.name FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE cards.artist = 'Matthew D. Wilson' AND foreign_data.language = 'French' AND cards.type = 'Creature' AND cards.layout = 'normal' AND cards.borderColor = 'black'"], "55c6ea7d09af19baa517a0f6e7fe2ee1191f2ec3": ["SELECT id FROM cards WHERE artist = 'Erica Yang' AND availability = 'paper' AND EXISTS (SELECT 1 FROM legalities WHERE legalities.uuid = cards.uuid AND format = 'pauper' AND status = 'Legal')"], "3bbb191d9a9530ae2dfec45f9e3f905e8be26726": ["SELECT st.language\nFROM sets s\nINNER JOIN set_translations st ON st.setCode = s.code\nWHERE s.baseSetSize = 180 AND s.block = 'Ravnica'"], "05cbd279e9fbc9a1455216fdbb7286af8e584a7c": ["SELECT id FROM cards WHERE types = 'Creature' AND uuid IN (SELECT uuid FROM legalities WHERE LOWER(status) = 'legal')"], "c352d8a544db9059762a3f49e701f6c84cf93e44": ["SELECT language FROM set_translations WHERE setCode IN (SELECT code FROM sets WHERE baseSetSize = 180 AND block = 'Ravnica')"], "56881e783d0cbaee18b50409ddbc692b210dd9f2": ["SELECT CAST(SUM(CASE WHEN cards.hasContentWarning = 0 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(cards.id) FROM cards JOIN legalities ON cards.uuid = legalities.uuid WHERE legalities.format = 'commander' AND legalities.status = 'legal'"], "7411b45f49c0a3cf973e375ba62ce8b37d95b598": ["SELECT fd.language\nFROM foreign_data fd\nINNER JOIN cards c ON fd.uuid = c.uuid\nWHERE fd.multiverseid = 149934"], "bd432d145f6bd97669521d36ccf943390722b0fc": ["SELECT (SELECT COUNT(*) FROM cards WHERE hasContentWarning = 0 AND uuid IN (SELECT uuid FROM legalities WHERE format = 'commander' AND status = 'legal')) * 100.0 / (SELECT COUNT(*) FROM cards WHERE uuid IN (SELECT uuid FROM legalities WHERE format = 'commander' AND status = 'legal'))"], "b6f5ec770c04a2e4f5abd1c1fd499e5be290cd00": ["SELECT language FROM foreign_data WHERE multiverseid = 149934"], "8e0f8367747272d7a5cf98ce521521b432b44972": ["SELECT CAST(SUM(CASE WHEN foreign_data.language = 'French' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*)\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.power IS NULL OR cards.power = '*'"], "7963878386bda3ac159c2b2a6fdeee8f797b280f": ["SELECT number FROM cards WHERE side IS NULL AND subtypes LIKE '%Angel%' AND subtypes LIKE '%Wizard%'"], "4c2c4b37a49fe6aaf83b61930df5540cbd92a79b": ["SELECT CAST(SUM(CASE WHEN layout = 'normal' THEN 1 ELSE 0 END) AS REAL) / COUNT(*) * 100 FROM cards WHERE isTextless = 1"], "33d983bb8e893083d18ad24241f0fa819f6b9949": ["SELECT (SELECT COUNT(*) FROM cards WHERE (power IS NULL OR power = '*') AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'French')) * 100.0 / (SELECT COUNT(*) FROM cards WHERE power IS NULL OR power = '*')"], "f4fa3f1ab3024fa2f6583e43b83e976b27e328a2": ["SELECT number FROM cards WHERE side IS NULL AND uuid IN (SELECT uuid FROM cards WHERE subtypes LIKE '%Angel%' AND subtypes LIKE '%Wizard%')"], "955acb8ba7e08cfcfd405d1e164273df791931fa": ["SELECT name\nFROM sets\nWHERE mtgoCode IS NULL OR mtgoCode = ''\nORDER BY name ASC\nLIMIT 3"], "09a8783c8a4257f35fd157516c6b0e5ff44ee029": ["SELECT (SELECT COUNT(*) FROM cards WHERE isTextless = 1 AND layout = 'normal') * 100.0 / (SELECT COUNT(*) FROM cards WHERE isTextless = 1)"], "8623aac9e0676d48a3ac2bab1de1042db54a53dc": ["SELECT DISTINCT foreign_data.language\nFROM sets\nJOIN cards ON cards.setCode = sets.code\nJOIN foreign_data ON foreign_data.uuid = cards.uuid\nWHERE sets.mcmName = 'Archenemy' AND sets.code = 'ARC'"], "b25fafb92d418d3d9ef898fae1b2eb6850fe3a12": ["SELECT name FROM sets WHERE code IN (SELECT code FROM sets WHERE mtgoCode IS NULL OR mtgoCode = '') ORDER BY name LIMIT 3"], "6389fd8fabcc5736023aa3b7edc2ff536cdf7cc7": ["SELECT name FROM foreign_data WHERE language = 'French' AND uuid IN (SELECT uuid FROM cards WHERE types LIKE '%Creature%' AND layout = 'normal' AND borderColor = 'black' AND artist = 'Matthew D. Wilson')"], "7235ff417df2e4d5276eab7f2a9731204f8c4097": ["SELECT DISTINCT language FROM set_translations WHERE setCode = 'ARC' AND setCode IN (SELECT code FROM sets WHERE mcmName = 'Archenemy')"], "6efefe7f2403c3bb744b0aff47a652710b17831e": ["SELECT T1.language, T2.type\nFROM set_translations AS T1\nINNER JOIN sets AS T2 ON T1.setCode = T2.code\nWHERE T2.id = 206"], "9763b275330a7da40e76eedf143b155f4be34f64": ["SELECT s.id, s.name FROM sets s JOIN cards c ON c.setCode = s.code JOIN foreign_data fd ON fd.uuid = c.uuid WHERE s.isForeignOnly = 1 AND s.isFoilOnly = 1 AND fd.language = 'Japanese'"], "f3f2f4a6cfee87c20e11f226fe17b9cab0d7b909": ["SELECT id, name FROM sets WHERE isForeignOnly = 1 AND isFoilOnly = 1 AND code IN (SELECT setCode FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Japanese'))"], "5ee98d41a5ac5d6be2b7ce3c89b98828cfd45799": ["SELECT sets.name\nFROM set_translations\nINNER JOIN sets ON set_translations.setCode = sets.code\nWHERE set_translations.language = 'Russian'\nORDER BY sets.baseSetSize DESC\nLIMIT 1"], "8ac98e360771bd533a3cc5912190e9860f4237c9": ["SELECT CAST(SUM(CASE WHEN T1.isOnlineOnly = 1 THEN 1 ELSE 0 END) AS REAL) / COUNT(T1.isOnlineOnly) * 100 FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T2.uuid = T1.uuid WHERE T2.language = 'Chinese Simplified'"], "b8f04f479228d86e873d5bc9a98c0c57d8e1151e": ["SELECT name FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Russian') AND baseSetSize = (SELECT MAX(baseSetSize) FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Russian'))"], "28410e7305fcaa14f7b22c4517241b53cf953e52": ["SELECT COUNT(DISTINCT T1.code)\nFROM sets AS T1\nJOIN set_translations AS T2 ON T1.code = T2.setCode\nWHERE T2.language = 'Japanese'\n  AND (T1.mtgoCode IS NULL OR T1.mtgoCode = '')"], "8694c96c2fd7666bef9dc544e156750239bc8b92": ["SELECT COUNT(*) FROM sets WHERE (mtgoCode IS NULL OR mtgoCode = '') AND code IN (SELECT setCode FROM set_translations WHERE language = 'Japanese')"], "3693d8bfe5573015267af567a284b9e87cd44c64": ["SELECT CAST(SUM(CASE WHEN sets.type = 'expansion' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*) AS percentage\nFROM set_translations\nINNER JOIN sets ON set_translations.setCode = sets.code\nWHERE set_translations.language = 'Japanese'"], "935b76deaceaa11aa86324fd3ce6c11c6059afdb": ["SELECT CAST(SUM(CASE WHEN isOnlineOnly = 1 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(isOnlineOnly) FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Chinese Simplified')"], "6c2a72d0477d091131e1c278793aa69f2557e433": ["SELECT name FROM cards WHERE borderColor = 'black' AND isFullArt = 1"], "7a1cb0fcae18d8995093e3be9e65738881baa885": ["SELECT (SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese' AND setCode IN (SELECT code FROM sets WHERE type = 'expansion')) * 100.0 / (SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese')"], "840ad24f90a5b826433929811cf3d47e4048983e": ["SELECT name FROM cards WHERE borderColor = 'black' AND uuid IN (SELECT uuid FROM cards WHERE isFullArt = 1)"], "34f04f0d01875541290dc727e49587c7b06f81da": ["SELECT name FROM sets WHERE code = 'ALL'"], "ad2008cc1fed811befe0eda5829c08bbb388ec8c": ["SELECT sets.name, sets.code\nFROM sets\nINNER JOIN cards ON cards.setCode = sets.code\nINNER JOIN foreign_data ON foreign_data.uuid = cards.uuid\nWHERE foreign_data.language = 'Italian'\n  AND sets.block = 'Shadowmoor'\nGROUP BY sets.name, sets.code\nORDER BY sets.name\nLIMIT 2"], "3d45e3f49e2975a38a2d120b7595135f346efbcd": ["SELECT name FROM sets WHERE code = 'ALL'"], "a75f6e0cd84216284a603ca51258e7dc217e40c8": ["SELECT id FROM cards WHERE borderColor = 'black'"], "a52e8ad4dfa7ae890552532c9ae31083da31620a": ["SELECT st.language\nFROM sets s\nJOIN set_translations st ON s.code = st.setCode\nWHERE s.id = 174"], "f6b2c68069a3481ca9b3e3d2d12e7b0b9f6a35b7": ["SELECT sets.baseSetSize, sets.code FROM sets WHERE sets.block IN ('Masques', 'Mirage')"], "282b6bd8816ec9d1f8c6fd9a48cfe1a4bb1fcb24": ["SELECT baseSetSize, code FROM sets WHERE block IN ('Masques', 'Mirage')"], "868159450f761964d5c20c70839a0eeccc1161ba": ["SELECT DISTINCT language FROM set_translations WHERE setCode IN (SELECT code FROM sets WHERE id = 174)"], "88a6049af34542534543f8797beb214cccce067d": ["SELECT T1.language, (SELECT T2.type FROM sets AS T2 WHERE T2.code = T1.setCode) FROM set_translations AS T1 WHERE T1.setCode IN (SELECT T3.code FROM sets AS T3 WHERE T3.id = 206)"], "b1a5e253bcc202bada38f814b50f9b710f44a5b7": ["SELECT foreign_data.language, foreign_data.flavorText, cards.type\nFROM cards\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.watermark = 'colorpie'"], "08574610f04cec6bc500fdf76f9490a189404ea3": ["SELECT COUNT(id), id FROM cards WHERE borderColor = 'black'"], "d18c2e7145a288ebbaf9faf55e54ccaec5ff92c4": ["SELECT id FROM sets WHERE block = 'Shadowmoor' AND code IN (SELECT setCode FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Italian')) ORDER BY id LIMIT 2"], "16dca2bdb6aa0bfc62965f0668967e5fc7f92102": ["SELECT language, flavorText, (SELECT type FROM cards WHERE cards.uuid = foreign_data.uuid) AS type FROM foreign_data WHERE uuid IN (SELECT uuid FROM cards WHERE watermark = 'colorpie')"], "245c392395d1b915f2e5684f27899bfb406cc10a": ["SELECT foreign_data.name, cards.type\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.watermark = 'Abzan'"], "2d4fbbee248ecffccf6c338c2f2fbf3ab6138404": ["SELECT fd.name, (SELECT c.type FROM cards c WHERE c.uuid = fd.uuid) AS type\nFROM foreign_data fd\nWHERE fd.uuid IN (SELECT uuid FROM cards WHERE watermark = 'Abzan')"], "2bd6185c60c3ff3df261b82db7ee9be39d6316de": ["SELECT foreign_data.language, cards.type\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.watermark = 'azorius'"], "bb60ba7ab2f1aa7e88985e506bbb97b9d71b35a2": ["SELECT COUNT(*) FROM cards WHERE artist = 'Aaron Miller' AND cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "d856f8a63ea09adb5157918951e2e064e189fe60": ["SELECT COUNT(*) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL AND uuid IN (SELECT uuid FROM cards WHERE artist = 'Aaron Miller')"], "1ced42730bbe1fdf16e3fa69b3f84ab651529c7f": ["SELECT manaCost FROM cards WHERE name = 'Ancestor`s Chosen'"], "2837907d93ac940939b39f8e6a2f3163ae486eb9": ["SELECT code FROM sets WHERE type = 'expansion'"], "20cda28dc4380b45f45d86fc5c3a33898bc2c818": ["SELECT code FROM sets WHERE type = 'expansion'"], "ce8c1904f91216dde4bb3f3f6b7e66d885393b3c": ["SELECT manaCost FROM cards WHERE name = 'Ancestor`s Chosen'"], "f6238219e3f537862d6bd57271a06a7686d087b2": ["SELECT COUNT(*) FROM cards WHERE borderColor = 'white' AND (power = '*' OR power IS NULL)"], "b868a8f828facbc31ebb3915341b06f61050affa": ["SELECT subtypes, supertypes FROM cards WHERE name = 'Molimo, Maro-Sorcerer'"], "95aed4de8572645b8d0b895be2b317b99a767c88": ["SELECT COUNT(*) FROM cards WHERE uuid IN (SELECT uuid FROM cards WHERE borderColor = 'white') AND (power = '*' OR power IS NULL)"], "45f78ad1018080cd97d86225bd76963688d8c5c5": ["SELECT subtypes, supertypes FROM cards WHERE name = 'Molimo, Maro-Sorcerer'"], "56f5866532915260c1d2d44ee3bb5984f09731d8": ["SELECT T2.name, T2.type\nFROM cards AS T1\nJOIN foreign_data AS T2 ON T1.uuid = T2.uuid\nWHERE T1.watermark = 'boros'"], "43badcf7283acbe5d15fd667c77f89cf2f2bc87e": ["SELECT purchaseUrls FROM cards WHERE promoTypes = 'bundle'"], "3ff4d72d68aab1a702f08ea15869260ecf7723f0": ["SELECT DISTINCT purchaseUrls FROM cards WHERE promoTypes = 'bundle'"], "0fa2f53ee7cc84c97c587abd4bf19561414c1825": ["SELECT artist FROM cards WHERE flavorName = 'Battra, Dark Destroyer'"], "c13783b22ef35f54b71d786bdc586c831d9f9a6b": ["SELECT name, type FROM foreign_data WHERE uuid IN (SELECT uuid FROM cards WHERE watermark = 'Boros')"], "3796a12ebc1d1a68a9e50508736582aa07a81779": ["SELECT artist FROM cards WHERE flavorName = 'Battra, Dark Destroyer'"], "a51b73297203da383ebe102e89c3ebd851118b3d": ["SELECT CASE WHEN c1.convertedManaCost > c2.convertedManaCost THEN c1.name ELSE c2.name END FROM cards c1 JOIN cards c2 ON c2.name = 'Shrine Keeper' WHERE c1.name = 'Serra Angel'"], "c6450756a04e5533643c69410784893965e38bd1": ["SELECT COUNT(foreign_data.language)\nFROM cards\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.name = 'Angel of Mercy'"], "471802fcac3d616b588df84b0e7444b9aecb01c3": ["SELECT T1.translation FROM set_translations AS T1 JOIN cards AS T2 ON T1.setCode = T2.setCode WHERE T2.name = 'Ancestor''s Chosen' AND T1.language = 'Italian'"], "4b1f93c31c5e78e2eedfa520a2ba5ea173fdbb19": ["SELECT COUNT(*) FROM set_translations WHERE setCode IN (SELECT setCode FROM cards WHERE name = 'Angel of Mercy')"], "2dfc812d7f5d7ec2557506738c332ad27e457457": ["SELECT translation FROM set_translations WHERE language = 'Italian' AND setCode IN (SELECT setCode FROM cards WHERE name = 'Ancestor''s Chosen')"], "6247a4652abaedbe72b18d517f7666f6b5abe43f": ["SELECT name FROM cards WHERE name IN ('Serra Angel', 'Shrine Keeper') AND convertedManaCost = (SELECT MAX(convertedManaCost) FROM cards WHERE name IN ('Serra Angel', 'Shrine Keeper'))"], "b047b6ddd218dc557f12ca01761969051e48bef2": ["SELECT COUNT(*) FROM cards JOIN sets ON cards.setCode = sets.code JOIN set_translations ON set_translations.setCode = sets.code WHERE set_translations.translation = 'Hauptset Zehnte Edition' AND cards.artist = 'Adam Rex'"], "dc54dbcd07cbe2e1283568bf8c621cc0f03c062c": ["SELECT COUNT(*) FROM cards WHERE artist = 'Adam Rex' AND setCode IN (SELECT setCode FROM set_translations WHERE translation = 'Hauptset Zehnte Edition')"], "1245ab6b236a0766bde7acfe83030abe3f4c6259": ["SELECT s.baseSetSize\nFROM set_translations st\nINNER JOIN sets s ON st.setCode = s.code\nWHERE st.translation = 'Hauptset Zehnte Edition'"], "3a6004f0f296688202f239548ac25a9544f284a5": ["SELECT COUNT(foreign_data.language)\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.name = 'Ancestor''s Chosen'\n  AND foreign_data.language = 'Korean'"], "07eacaeb85df4c9d899a7b9d6ba3f1a00b54a10c": ["SELECT T1.translation FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T1.name = 'Eighth Edition' AND T2.language = 'Chinese Simplified'"], "d5655dde2d9835562a28a95a451ebd7c79de8ce9": ["SELECT translation FROM set_translations WHERE language = 'Chinese Simplified' AND setCode IN (SELECT code FROM sets WHERE name = 'Eighth Edition')"], "3a40fbcf8c7fb924c0d5ddfb960f989178dea8a8": ["SELECT baseSetSize FROM sets WHERE code = (SELECT setCode FROM set_translations WHERE translation = 'Hauptset Zehnte Edition')"], "52efa4ee218a52ff04d2672af7b2c117e422dfb2": ["SELECT COUNT(DISTINCT s.code)\nFROM sets s\nINNER JOIN set_translations st ON st.setCode = s.code\nWHERE s.block = 'Ice Age'\n  AND st.language = 'Italian'\n  AND st.translation IS NOT NULL"], "3e4417f62d0f22d969cd1fb78539948d7048cb9c": ["SELECT COUNT(*) FROM foreign_data WHERE language = 'Korean' AND uuid IN (SELECT uuid FROM cards WHERE name = 'Ancestor''s Chosen')"], "23bf137c6ef962a5f2eec68a7f76c3311a6be0bb": ["SELECT COUNT(*) FROM sets WHERE block = 'Ice Age' AND code IN (SELECT setCode FROM set_translations WHERE language = 'Italian' AND translation IS NOT NULL)"], "75ed1a3186383e3f89b1b1587a8e0f284d2d6bba": ["SELECT T2.mtgoCode IS NOT NULL FROM cards AS T1 INNER JOIN sets AS T2 ON T1.setCode = T2.code WHERE T1.name = 'Angel of Mercy'"], "992c1d1a1aa57d13549b2abc31c65e7a00c6c76b": ["SELECT name FROM sets WHERE code IN (SELECT setCode FROM cards WHERE name = 'Angel of Mercy') AND mtgoCode IS NOT NULL"], "47afd63029f149c67e266db231c986118c9ff3f5": ["SELECT sets.name FROM cards INNER JOIN sets ON cards.setCode = sets.code WHERE cards.name = 'Adarkar Valkyrie' AND sets.isForeignOnly = 1"], "19a393273985079e763d6ad5434b04ab1027c283": ["SELECT isForeignOnly FROM sets WHERE code IN (SELECT setCode FROM cards WHERE name = 'Adarkar Valkyrie')"], "d33e6e7d92961e1901433b4bce124735f9b8e5e4": ["SELECT DISTINCT T1.name FROM cards AS T1 INNER JOIN sets AS T2 ON T1.setCode = T2.code WHERE T2.name = 'Coldsnap' AND T1.convertedManaCost = (SELECT MAX(T3.convertedManaCost) FROM cards AS T3 INNER JOIN sets AS T4 ON T3.setCode = T4.code WHERE T4.name = 'Coldsnap')"], "49e152c8171dcfeb781816614c0dff47f47b3989": ["SELECT DISTINCT name FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap') AND convertedManaCost = (SELECT MAX(convertedManaCost) FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap'))"], "fada24b73634b09387b97a54dd79463bcbc68a55": ["SELECT DISTINCT c.artist\nFROM cards c\nINNER JOIN sets s ON c.setCode = s.code\nWHERE s.name = 'Coldsnap'\n  AND c.artist IN ('Jeremy Jarvis', 'Aaron Miller', 'Chippy')"], "d12dc5ae4f2054eb2d3455ea537bf52d34b4d6ec": ["SELECT DISTINCT artist FROM cards WHERE artist IN ('Jeremy Jarvis', 'Aaron Miller', 'Chippy') AND setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap')"], "becab69fdf662f8b4657f7b094e1e461e6f8b697": ["SELECT COUNT(T1.id) FROM cards AS T1 INNER JOIN sets AS T2 ON T1.setCode = T2.code WHERE T2.name = 'Coldsnap' AND T1.convertedManaCost > 5 AND (T1.power = '*' OR T1.power IS NULL)"], "9cd7be78ba2ed8da7941a2d364561b10fe29df26": ["SELECT foreign_data.flavorText\nFROM cards\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE foreign_data.language = 'Italian' AND cards.name = 'Ancestor''s Chosen'"], "e6d664e9211d6517b97d5f59d6b1e89535106c3a": ["SELECT flavorText FROM foreign_data WHERE language = 'Italian' AND uuid IN (SELECT uuid FROM cards WHERE name = 'Ancestor''s Chosen')"], "d3ca7f1ef28885679cde08cb976decd5a19af17f": ["SELECT COUNT(*) FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap') AND convertedManaCost > 5 AND (power = '*' OR power IS NULL)"], "085b1f460b3e7b988fd46c56c3199004d772c6c1": ["SELECT T2.type FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T1.name = 'Ancestor''s Chosen' AND T2.language = 'German'"], "fad899f619d69514a4512137227486d2a93508da": ["SELECT DISTINCT foreign_data.language\nFROM cards\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.name = 'Ancestor''s Chosen'\n  AND foreign_data.flavorText IS NOT NULL"], "ba9bd638874ca622bec5db9ab49df1652fcf06be": ["SELECT language, type FROM foreign_data WHERE uuid IN (SELECT uuid FROM cards WHERE watermark = 'azorius')"], "42f8e159b74ce51e1c65bab76246b6b62b917027": ["SELECT language FROM foreign_data WHERE flavorText IS NOT NULL AND uuid IN (SELECT uuid FROM cards WHERE name = 'Ancestor''s Chosen')"], "794c3d29e2f0018fa14437b4aa823578ced574a5": ["SELECT COUNT(DISTINCT sets.code)\nFROM sets\nINNER JOIN set_translations ON sets.code = set_translations.setCode\nWHERE set_translations.language = 'Italian'\n  AND set_translations.translation IS NOT NULL\n  AND sets.baseSetSize < 100"], "bf841802fd4e1d560afba2992c55e5f0c96e756b": ["SELECT type FROM foreign_data WHERE language = 'German' AND uuid IN (SELECT uuid FROM cards WHERE name = 'Ancestor''s Chosen')"], "602270b538011ea4b85354492e5137710cd66e4d": ["SELECT rulings.date FROM cards INNER JOIN rulings ON cards.uuid = rulings.uuid WHERE cards.name = 'Reminisce'"], "4db105c162d2a6ae5fd1e04c11df048cba9033b6": ["SELECT date FROM rulings WHERE uuid IN (SELECT uuid FROM cards WHERE name = 'Reminisce')"], "0af3b2a32a46c3fbcd58384ce4cabe1acc33141e": ["SELECT fd.name\nFROM cards c\nJOIN sets s ON c.setCode = s.code\nJOIN (SELECT setCode, MAX(convertedManaCost) AS maxCmc FROM cards GROUP BY setCode) m\n  ON m.setCode = c.setCode AND c.convertedManaCost = m.maxCmc\nJOIN foreign_data fd ON fd.uuid = c.uuid\nWHERE s.name = 'Coldsnap' AND fd.language = 'Italian'"], "cf94b68f2cd8c42e6fa6d77f67cb764c5ccfe72a": ["SELECT name FROM foreign_data WHERE language = 'Italian' AND uuid IN (SELECT uuid FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap') AND convertedManaCost = (SELECT MAX(convertedManaCost) FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap')))"], "d8f4423c99f5df963821830497924537714a1e4e": ["SELECT SUM(CASE WHEN T1.cardKingdomFoilId IS NOT NULL AND T1.cardKingdomId IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(T1.id) FROM cards AS T1 INNER JOIN sets AS T2 ON T1.setCode = T2.code WHERE T2.name = 'Coldsnap'"], "29e5da2f0f3492fd920ba4af0594af951156fc79": ["SELECT COUNT(*) FROM sets WHERE baseSetSize < 10 AND code IN (SELECT setCode FROM set_translations WHERE language = 'Italian' AND translation IS NOT NULL)"], "572e4f2a40ae7b7a1256b39b410e4ed69ae8e12f": ["SELECT code FROM sets WHERE releaseDate = '2017-07-14'"], "d149bc7eabd378ac9941bf404b433628c4edcc91": ["SELECT COUNT(CASE WHEN cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL THEN 1 END) * 100.0 / COUNT(*) FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap')"], "babc71bd3d00fd6ea84dc702b554843b3f7372a0": ["SELECT code FROM sets WHERE releaseDate = '2017-07-14'"], "69c7f0400ae1a968be053690056d8c66edf709bb": ["SELECT sets.type FROM sets WHERE sets.name LIKE '%From the Vault: Lore%'"], "e1845717524316cec6b207e35237a963fdabb074": ["SELECT type FROM sets WHERE name LIKE '%From the Vault: Lore%'"], "79ad7eca2b2a87f21407454be88a726e9f87a89e": ["SELECT DISTINCT sets.releaseDate FROM cards JOIN sets ON cards.setCode = sets.code WHERE cards.name = 'Evacuation'"], "e55b816109b81fe13a21f52fe88fc9281a467be4": ["SELECT sets.parentCode FROM sets WHERE sets.name = 'Commander 2014 Oversized'"], "51ae8668c206c06fbffafa8c02a427cc7d27e403": ["SELECT releaseDate FROM sets WHERE code IN (SELECT setCode FROM cards WHERE name = 'Evacuation')"], "c085a66adda5393702418287614f6b20fdf38264": ["SELECT parentCode FROM sets WHERE name = 'Commander 2014 Oversized'"], "06d73862d0a7c7faeb91a5745927294f9b0b1078": ["SELECT T1.type FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.translation = 'Huiti\u00e8me \u00e9dition'"], "2cb30cb31901d2a97a36ac1be8ad288b7cef2da7": ["SELECT type FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE translation = 'Huiti\u00e8me \u00e9dition')"], "1505156e3def2f757ca3187f4d5b4eaf06bcdd26": ["SELECT COUNT(set_translations.translation) FROM sets INNER JOIN set_translations ON set_translations.setCode = sets.code WHERE sets.name = 'Tenth Edition' AND set_translations.translation IS NOT NULL"], "f7098f9ba7b601d72e260da40cc0cda8f4ad06b1": ["SELECT COUNT(translation) FROM set_translations WHERE translation IS NOT NULL AND setCode IN (SELECT code FROM sets WHERE name = 'Tenth Edition')"], "48776520a05295d093383ae989a3f8c1811e0ed9": ["SELECT st.translation\nFROM cards c\nINNER JOIN set_translations st ON c.setCode = st.setCode\nWHERE c.name = 'Fellwar Stone'\n  AND st.language = 'Japanese'"], "964b6cef7a6b4edf59c797660cb7f5188df47c42": ["SELECT translation FROM set_translations WHERE language = 'Japanese' AND setCode IN (SELECT setCode FROM cards WHERE name = 'Fellwar Stone')"], "1a873761fea095154f56ab8044a7e00fddac33a9": ["SELECT cards.name FROM cards INNER JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Journey into Nyx Hero''s Path' ORDER BY cards.convertedManaCost DESC LIMIT 1"], "7ea70c68dc4d7f34d311e1965c814a72dbd5bb66": ["SELECT name FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Journey into Nyx Hero''s Path') ORDER BY convertedManaCost DESC LIMIT 1"], "ca612668414cf7299ac27be7601c4d4288790b9f": ["SELECT sets.releaseDate FROM sets INNER JOIN set_translations ON sets.code = set_translations.setCode WHERE set_translations.translation = 'Ola de fr\u00edo'"], "88ee0858ea22f11100ccd95c341e504cdfd3588b": ["SELECT releaseDate FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE translation = 'Ola de fr\u00edo')"], "6ea90fca667b2c584d629c12d4824658f6bc1fc6": ["SELECT DISTINCT sets.type\nFROM cards\nINNER JOIN sets ON cards.setCode = sets.code\nWHERE cards.name = 'Samite Pilgrim'"], "09c0b2c84abf176608418eb9863a1a558f2b0569": ["SELECT type FROM sets WHERE code IN (SELECT setCode FROM cards WHERE name = 'Samite Pilgrim')"], "4efd94122bfc652258e15af29c35866f89c87c02": ["SELECT T2.translation FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T1.name = 'Mirrodin' AND T2.language = 'Chinese Simplified'"], "db825ec8d86db2cb2bd5b141454e5c807a5483e9": ["SELECT translation FROM set_translations WHERE language = 'Chinese Simplified' AND setCode IN (SELECT code FROM sets WHERE name = 'Mirrodin')"], "1392840891e93e3a600c23a3fb62679a399c0829": ["SELECT CAST(SUM(CASE WHEN convertedManaCost = 10 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(convertedManaCost) FROM cards WHERE setCode IN (SELECT setCode FROM cards WHERE name = 'Abyssal Horror')"], "b0449da2711dc5360adac0dc4619db1cc40b0047": ["SELECT id FROM sets ORDER BY baseSetSize DESC LIMIT 1"], "926722bd88be1dfbf2b35c897d99819f107afbb6": ["SELECT id FROM sets WHERE baseSetSize = (SELECT MAX(baseSetSize) FROM sets)"], "ea153faf945219b4d767f1ebcfdb076941063e77": ["SELECT SUM(CASE WHEN T1.isOnlineOnly = 1 THEN 1 ELSE 0 END) * 100.0 / SUM(CASE WHEN T2.language = 'Portuguese (Brazil)' THEN 1 ELSE 0 END) FROM cards AS T1 INNER JOIN foreign_data AS T2 ON T1.uuid = T2.uuid WHERE T2.language = 'Portuguese (Brazil)'"], "0cc9f2f77d7edd79814760cee8e68c3e09d598cc": ["SELECT artist\nFROM cards\nWHERE side IS NULL\nORDER BY convertedManaCost DESC\nLIMIT 1"], "19c0eb2ce114a6d213a795d4ea8722d0f9533af4": ["SELECT artist FROM cards WHERE side IS NULL AND convertedManaCost = (SELECT MAX(convertedManaCost) FROM cards WHERE side IS NULL)"], "c720c24c9288a578f9277545c66f2bcd019b3c11": ["SELECT MAX(frameEffects) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "ae53b1b9aca9e4f982ea43f4dbbfc8cd9308bc6e": ["SELECT SUM(cards.convertedManaCost = 7) * 100.0 / SUM(cards.convertedManaCost) FROM cards INNER JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Coldsnap'"], "ac670a4716ff67f4d1b1ecd8148e943e1be3bc16": ["SELECT CAST(SUM(CASE WHEN isOnlineOnly = 1 THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(*)\nFROM cards\nWHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Portuguese (Brazil)')"], "359bca3a1f813ff0ef7d677fd273c67413a693bd": ["SELECT MAX(frameEffects) FROM cards WHERE cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL"], "4b3570a82ca6c4dd2f2e1bb988c5f86e31aa47d5": ["SELECT id FROM sets WHERE type = 'commander' ORDER BY totalSetSize DESC LIMIT 1"], "b018b587506598eb5ba56f5efcb8cc822b797275": ["SELECT id FROM sets WHERE type = 'commander' AND totalSetSize = (SELECT MAX(totalSetSize) FROM sets WHERE type = 'commander')"], "7129ac570472bab8b632f54dbe181d55cf30dceb": ["SELECT cards.name FROM legalities INNER JOIN cards ON legalities.uuid = cards.uuid WHERE legalities.format = 'duel' ORDER BY cards.manaCost DESC LIMIT 10"], "0da2dfa83bf91c8d6bcb43e88f0860a12d8d1e95": ["SELECT CAST(SUM(convertedManaCost = 7) AS REAL) / SUM(convertedManaCost) * 100 AS percentage FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap')"], "ccf20932e2aad5b0f5e05739e1d38da518ea1e63": ["SELECT c.originalReleaseDate, l.format\nFROM cards c\nJOIN legalities l ON l.uuid = c.uuid\nWHERE c.rarity = 'mythic'\n  AND c.originalReleaseDate = (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic')\n  AND l.status = 'legal'"], "2d3e3df5fc2f2bc502e2fd4dacc36a765233a8e6": ["SELECT foreign_data.text\nFROM cards\nINNER JOIN sets ON cards.setCode = sets.code\nINNER JOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE sets.name = 'Coldsnap'\n  AND foreign_data.language = 'Italian'"], "0f2d0574e295b66af9bbf0ef7afcc012a65717a3": ["SELECT (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic') AS originalReleaseDate, T1.format FROM legalities AS T1 WHERE T1.status = 'legal' AND T1.uuid IN (SELECT T2.uuid FROM cards AS T2 WHERE T2.rarity = 'mythic' AND T2.originalReleaseDate = (SELECT MIN(originalReleaseDate) FROM cards WHERE rarity = 'mythic'))"], "f517c015b099d4242ecdfad4f939ce1aa6e0790a": ["SELECT name FROM cards WHERE uuid IN (SELECT uuid FROM legalities WHERE format = 'duel') ORDER BY manaCost DESC LIMIT 10"], "eadaf098b1517f6ffec72a84ab267daea1feed38": ["SELECT text FROM foreign_data WHERE language = 'Italian' AND uuid IN (SELECT uuid FROM cards WHERE setCode IN (SELECT code FROM sets WHERE name = 'Coldsnap'))"], "a2c84f42aee36c75cdbd2117542869d4d5f4710a": ["SELECT COUNT(*) FROM cards INNER JOIN foreign_data ON cards.uuid = foreign_data.uuid WHERE cards.artist LIKE 'Volkan Ba%' AND foreign_data.language = 'French'"], "1b4d5ee300ce1d7301fddf4e302a2cae43d3fff4": ["SELECT COUNT(*) FROM cards WHERE artist = 'Volkan Ba\u01f5a' AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'French')"], "bf986b2369bc7ab071a6aed06b83c14aa0521358": ["SELECT cards.name, legalities.format FROM cards INNER JOIN legalities ON cards.uuid = legalities.uuid WHERE cards.edhrecRank = 1 AND legalities.status = 'Banned'"], "d0726fd162a51870995c955be075a1b1a46cf090": ["SELECT name, (SELECT format FROM legalities WHERE legalities.uuid = cards.uuid AND status = 'Banned') AS banned_format FROM cards WHERE edhrecRank = 1 AND EXISTS (SELECT 1 FROM legalities WHERE legalities.uuid = cards.uuid AND status = 'Banned')"], "3151a53974e7ced240d3125c5262cfa5d2cfdf5e": ["SELECT f.format, c.name\nFROM legalities l\nJOIN cards c ON c.uuid = l.uuid\nJOIN (SELECT format, COUNT(*) AS cnt FROM legalities WHERE status = 'Banned' GROUP BY format) f ON f.format = l.format\nLEFT JOIN (SELECT format, COUNT(*) AS cnt FROM legalities WHERE status = 'Banned' GROUP BY format) g ON g.cnt > f.cnt\nWHERE l.status = 'Banned' AND g.format IS NULL"], "2e93c75e5b295968da65eb11a2c97885e10a6346": ["SELECT format, (SELECT name FROM cards WHERE cards.uuid = legalities.uuid) AS name FROM legalities WHERE status = 'Banned' AND format = (SELECT format FROM legalities WHERE status = 'Banned' GROUP BY format ORDER BY COUNT(*) DESC LIMIT 1)"], "888375e919eb1b7793ca23039f845bfc1d75636b": ["SELECT legalities.uuid FROM legalities INNER JOIN cards ON legalities.uuid = cards.uuid WHERE legalities.format = 'oldschool' AND (legalities.status = 'banned' OR legalities.status = 'restricted')"], "e85bf83a8763d3bf9725896fa8d562b23e38d669": ["SELECT uuid FROM legalities WHERE format = 'oldschool' AND status IN (SELECT 'banned' UNION SELECT 'restricted')"], "a567f6110f6430755437ff49f35cf23d8e552bc3": ["SQL: SELECT COUNT(*) FROM cards WHERE artist = 'Matthew D. Wilson' AND availability = 'paper'"], "9fc9331871c6cf750a7b9ffc09f97714931750db": ["SELECT COUNT(*) FROM cards WHERE artist = 'Matthew D. Wilson' AND uuid IN (SELECT uuid FROM cards WHERE availability = 'paper')"], "95973f8495e4ab3e5c7b650c9362c65b048c43b4": ["SELECT c.artist, l.format\nFROM cards c\nJOIN legalities l ON l.uuid = c.uuid\nWHERE c.artist = (\n    SELECT artist\n    FROM cards\n    GROUP BY artist\n    ORDER BY COUNT(*) ASC\n    LIMIT 1\n)"], "522fb44ed746ce11b740b99df6d92634205ede4e": ["SELECT cards.name, rulings.date, rulings.text FROM cards INNER JOIN rulings ON cards.uuid = rulings.uuid WHERE cards.artist = 'Kev Walker' ORDER BY rulings.date DESC"], "bfad85d7b21e7d5bc6051fae110e2a2a62721d3c": ["SELECT COUNT(DISTINCT T1.id) FROM cards AS T1 INNER JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T1.name = 'Abundance' AND T1.rarity = 'rare' AND T1.types = 'Enchantment' AND T2.status = 'Legal'"], "9a1c9c5818fe4f8074ec705e633c9cd109359b76": ["SQL: SELECT COUNT(*) FROM cards WHERE name = 'Abundance' AND rarity = 'rare' AND types = 'Enchantment' AND uuid IN (SELECT uuid FROM legalities WHERE status = 'Legal') AND uuid NOT IN (SELECT uuid FROM legalities WHERE status <> 'Legal')"], "5f8d6323ecfc11954909274c874235efcff1cf8a": ["SELECT cards.name, legalities.format\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE sets.name = 'Hour of Devastation' AND legalities.status = 'Legal'"], "341f5ae216d116c7a4a016926fd3acef53d47acd": ["SELECT text FROM rulings WHERE uuid IN (SELECT uuid FROM cards WHERE artist = 'Kev Walker') ORDER BY MAX(date) DESC"], "e2313281c77b5e53cdb10f6537505be94549b626": ["SELECT DISTINCT s.name\nFROM sets s\nINNER JOIN set_translations st ON st.setCode = s.code AND st.language = 'Korean'\nLEFT JOIN set_translations stj ON stj.setCode = s.code AND stj.language = 'Japanese'\nWHERE stj.setCode IS NULL"], "010108ecd8f0ac21a28c0e4b160d0f9fff8e3aea": ["SELECT name FROM sets WHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Korean') AND code NOT IN (SELECT setCode FROM set_translations WHERE language LIKE '%Japanese%')"], "501ff7022a2424e4c69843c0f5d3c602548ce047": ["SELECT T1.frameVersion, T1.name, T2.status FROM cards AS T1 JOIN legalities AS T2 ON T1.uuid = T2.uuid WHERE T1.artist = 'Allen Williams' AND T2.status = 'Banned'"], "b79134f298a268314e4f419753d6cabf005ad194": ["SELECT (SELECT cards.name FROM cards WHERE cards.uuid = legalities.uuid) AS name, legalities.format FROM legalities WHERE legalities.status = 'Legal' AND legalities.uuid IN (SELECT cards.uuid FROM cards WHERE cards.setCode IN (SELECT sets.code FROM sets WHERE sets.name = 'Hour of Devastation'))"], "20252d06eff6892024d162290b9703efbffd2c71": ["SELECT DISTINCT format FROM legalities WHERE uuid IN (SELECT uuid FROM cards WHERE artist = (SELECT artist FROM cards GROUP BY artist ORDER BY COUNT(*) ASC LIMIT 1))"], "b2b10002e52b82bfc16fc332d4993a37bb22747f": ["SELECT frameVersion, name FROM cards WHERE artist = 'Allen Williams' AND uuid IN (SELECT uuid FROM legalities WHERE status = 'Banned')"], "1cc7aed3665fc9fd535caabd1641c56f81a26f01": ["SELECT DISTINCT seasons.year FROM seasons INNER JOIN races ON seasons.year = races.year INNER JOIN circuits ON races.circuitId = circuits.circuitId WHERE circuits.location = 'Shanghai'"], "0ca1bc7b4e39fe6a65de988e4cfdf4ea13829f01": ["SELECT year FROM races WHERE circuitId IN (SELECT circuitId FROM circuits WHERE location = 'Shanghai')"], "2e986eedef59a6608b26c0d08f325b0817ebc311": ["SELECT DISTINCT circuits.lat, circuits.lng FROM circuits INNER JOIN races ON circuits.circuitId = races.circuitId WHERE races.name = 'Australian Grand Prix'"], "945fece4be36ac5c2b0fd0b168a3b446609ff8a4": ["SELECT T2.url FROM constructorResults AS T1 INNER JOIN constructors AS T2 ON T1.constructorId = T2.constructorId WHERE T1.raceId = 9 ORDER BY T1.points DESC LIMIT 1"], "8bf42b5bf0518d4c3c424e4cdbda4bc6df6aa756": ["SELECT COUNT(*) FROM races r INNER JOIN circuits c ON r.circuitId = c.circuitId WHERE r.year = 2010 AND c.country NOT IN ('Austria','Azerbaijan','Bahrain','Belgium','China','France','Germany','Hungary','India','Italy','Japan','Korea','Malaysia','Monaco','Netherlands','Portugal','Russia','Saudi Arabia','Singapore','Spain','Sweden','Switzerland','Turkey','UAE','UK','Vietnam','Europe')"], "d40a0e5137d91b6fd5f3bbc3b4156905bd424762": ["SELECT url FROM constructors WHERE constructorId IN (SELECT constructorId FROM constructorResults WHERE raceId = 9 AND points = (SELECT MAX(points) FROM constructorResults WHERE raceId = 9))"], "f847e5272a7d4977519d95584b669d413a44242e": ["SELECT lat, lng FROM circuits WHERE circuitId IN (SELECT circuitId FROM races WHERE name = 'Australian Grand Prix')"], "de3abd1f58f68483d277618a0554a62fc4f2463e": ["SELECT seasons.url\nFROM seasons\nINNER JOIN races ON seasons.year = races.year\nWHERE races.raceId = 901"], "14d0ac691ca000dca62ca3a9093a55cc1fe2f930": ["SELECT url FROM seasons WHERE year IN (SELECT year FROM races WHERE raceId = 901)"], "d1dbe54ec19f159e44ee7c6b97e73d7a94f1e73a": ["SELECT drivers.forename, drivers.surname FROM drivers INNER JOIN results ON drivers.driverId = results.driverId WHERE results.raceId = 872 AND results.time IS NOT NULL ORDER BY drivers.dob DESC LIMIT 1"], "f4868fed818e3b1d3b4b0b8cfbd57b887a9b98c5": ["SELECT ((CAST(T1.fastestLapSpeed AS REAL) - CAST(T2.fastestLapSpeed AS REAL)) * 100) / CAST(T1.fastestLapSpeed AS REAL) AS percentage\nFROM results AS T1\nJOIN results AS T2 ON T1.driverId = T2.driverId\nJOIN drivers ON drivers.driverId = T1.driverId\nWHERE drivers.forename = 'Paul' AND drivers.surname = 'di Resta'\n  AND T1.raceId = 853 AND T2.raceId = 854"], "c999721bdb00f981fd1a39826b2f0c0fcbe7c151": ["SELECT COUNT(*) FROM races WHERE year = 2010 AND name LIKE '%Grand Prix%' AND circuitId IN (SELECT circuitId FROM circuits WHERE country NOT IN ('Bahrain', 'China', 'India', 'Japan', 'Malaysia', 'Singapore', 'South Korea', 'Korea', 'UAE', 'Vietnam', 'Saudi Arabia', 'Qatar', 'Russia', 'Azerbaijan', 'Turkey', 'Spain', 'Monaco', 'Germany', 'France', 'UK', 'Britain', 'Austria', 'Hungary', 'Belgium', 'Italy', 'Portugal', 'San Marino', 'Netherlands', 'Sweden', 'Switzerland'))"], "405f28ac35e4f087b9e8ba3a39deb2b3bfcbb358": ["SELECT forename, surname\nFROM drivers\nWHERE driverId IN (SELECT driverId FROM results WHERE raceId = 872 AND time IS NOT NULL)\n  AND dob = (SELECT MAX(dob) FROM drivers WHERE driverId IN (SELECT driverId FROM results WHERE raceId = 872 AND time IS NOT NULL))"], "28ba125a773cf9c41c4496acc11ae386bbfedc31": ["SELECT AVG(lapTimes.milliseconds) FROM lapTimes INNER JOIN drivers ON lapTimes.driverId = drivers.driverId INNER JOIN races ON lapTimes.raceId = races.raceId WHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton' AND races.name = 'Malaysian Grand Prix' AND races.year = 2009"], "414d3ae49de4d1c60b4d225ddc068cd6220d0b89": ["SELECT AVG(lapTimes.milliseconds) FROM lapTimes WHERE lapTimes.driverId = (SELECT drivers.driverId FROM drivers WHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton') AND lapTimes.raceId = (SELECT races.raceId FROM races WHERE races.name = 'Malaysian Grand Prix' AND races.year = 2009)"], "a5e5aef60d8a1ee359a9befe482eda4799d1f3ac": ["SELECT (\n  (SELECT fastestLapSpeed FROM results WHERE raceId = 853 AND driverId = (SELECT driverId FROM drivers WHERE forename = 'Paul' AND surname = 'di Resta'))\n  -\n  (SELECT fastestLapSpeed FROM results WHERE raceId = 854 AND driverId = (SELECT driverId FROM drivers WHERE forename = 'Paul' AND surname = 'di Resta'))\n) * 100 / (SELECT fastestLapSpeed FROM results WHERE raceId = 853 AND driverId = (SELECT driverId FROM drivers WHERE forename = 'Paul' AND surname = 'di Resta'))"], "18be9603d46ead4cbb3d8c07bf914b36079bb942": ["SELECT AVG(T1.id), T2.language FROM sets AS T1 INNER JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T1.releaseDate BETWEEN '2012-01-01' AND '2015-12-31' GROUP BY T2.language ORDER BY COUNT(T2.language) DESC LIMIT 1"], "9e412209be923862b8222585218f7d4163b898fc": ["SELECT translation FROM set_translations WHERE language = 'French' AND setCode IN (SELECT setCode FROM cards WHERE name = 'Tendo Ice Bridge')"], "beb17b33beab9bb9b73c664ae8758986d5f30afc": ["SELECT 100.0 * SUM(CASE WHEN r.position > 1 THEN 1 ELSE 0 END) / COUNT(r.raceId) AS percentage\nFROM results r\nINNER JOIN drivers d ON r.driverId = d.driverId\nINNER JOIN races ra ON r.raceId = ra.raceId\nWHERE d.surname = 'Hamilton' AND ra.year >= 2010"], "387912d9ab52cac0334c169f545ff33f251c8ce6": ["SELECT 100.0 * (SELECT COUNT(raceId) FROM results WHERE driverId IN (SELECT driverId FROM drivers WHERE surname = 'Hamilton') AND raceId IN (SELECT raceId FROM races WHERE year >= 2010) AND position > 1) / (SELECT COUNT(raceId) FROM results WHERE driverId IN (SELECT driverId FROM drivers WHERE surname = 'Hamilton') AND raceId IN (SELECT raceId FROM races WHERE year >= 2010)) AS percentage"], "5122b3181a7c5f78c836757498d26fcb85507d03": ["SELECT d.forename, d.surname, d.nationality, MAX(ds.points)\nFROM drivers d\nINNER JOIN driverStandings ds ON d.driverId = ds.driverId\nGROUP BY d.driverId, d.forename, d.surname, d.nationality\nORDER BY COUNT(ds.wins) DESC\nLIMIT 1"], "d2e5fe100b7b32de2dae1b9f7bdf004568dd407e": ["SELECT d.forename, d.surname, SUM(r.points) AS points\nFROM drivers d\nINNER JOIN results r ON d.driverId = r.driverId\nGROUP BY d.driverId, d.forename, d.surname\nORDER BY points DESC\nLIMIT 1"], "1687d4bcd002229bcd282bb8c04f77280cef77c1": ["SELECT strftime('%Y', CURRENT_TIMESTAMP) - strftime('%Y', dob) AS age, forename, surname FROM drivers WHERE nationality = 'Japanese' ORDER BY dob DESC LIMIT 1"], "064966f2dd93dd10ad46a58210ea87bd4ff0afb8": ["SELECT COUNT(DISTINCT r.driverId)\nFROM results r\nJOIN races ra ON r.raceId = ra.raceId\nWHERE ra.year = 2008\n  AND ra.name = 'Australian Grand Prix'\n  AND r.time IS NOT NULL"], "01e33b48cf5f45901454f2ec19b189b09aa14975": ["SELECT COUNT(DISTINCT driverId) FROM results WHERE time IS NOT NULL AND raceId IN (SELECT raceId FROM races WHERE year = 2008 AND name = 'Australian Grand Prix')"], "69dc567cc73e280218243f8b712ca63675570074": ["SELECT CAST(strftime('%Y', CURRENT_TIMESTAMP) AS INTEGER) - CAST(strftime('%Y', dob) AS INTEGER) AS age, forename || ' ' || surname AS name\nFROM drivers\nWHERE nationality = 'Japanese'\n  AND dob = (SELECT MAX(dob) FROM drivers WHERE nationality = 'Japanese')"], "f5ef649128146e901dd980d9978b72523939330a": ["SELECT AVG(cnt) AS annual_average_sets,\n       (SELECT language\n        FROM foreign_data\n        GROUP BY language\n        HAVING COUNT(language) = (SELECT MAX(num)\n                                  FROM (SELECT COUNT(language) AS num\n                                        FROM foreign_data\n                                        GROUP BY language))) AS common_language\nFROM (SELECT COUNT(id) AS cnt\n      FROM sets\n      WHERE releaseDate BETWEEN '2012-01-01' AND '2015-12-31'\n      GROUP BY substr(releaseDate, 1, 4)) AS yearly_counts"], "12818a4bd04a63d108303c4131d8c056fac949e5": ["SELECT AVG(CAST(substr(fastestLapTime, 1, instr(fastestLapTime, ':') - 1) AS INTEGER) * 60 + CAST(substr(fastestLapTime, instr(fastestLapTime, ':') + 1) AS REAL)) AS average_fastest_lap_time\nFROM results\nINNER JOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'"], "b2b5b614a6f7ae645661a9cf787ef980255285ce": ["SELECT 100.0 * SUM(CASE WHEN results.time IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*) AS percentage\nFROM results\nINNER JOIN races ON results.raceId = races.raceId\nINNER JOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.nationality = 'Japanese' AND races.year BETWEEN 2007 AND 2009"], "cc082221656c544a059a2a05728efac04a4dc560": ["SELECT (SELECT COUNT(*) FROM results WHERE time IS NOT NULL AND driverId IN (SELECT driverId FROM drivers WHERE nationality = 'Japanese') AND raceId IN (SELECT raceId FROM races WHERE year BETWEEN 2007 AND 2009)) * 100.0 / (SELECT COUNT(*) FROM results WHERE driverId IN (SELECT driverId FROM drivers WHERE nationality = 'Japanese') AND raceId IN (SELECT raceId FROM races WHERE year BETWEEN 2007 AND 2009))"], "9aaf3a6868b26912128352bd87b3eb31cd78ab89": ["SELECT AVG(T1.fastestLapSpeed) FROM results AS T1 INNER JOIN races AS T2 ON T1.raceId = T2.raceId WHERE T2.name = 'Spanish Grand Prix' AND T2.year = 2009"], "701a9714305799170cf02b270db6b1138a2a34e8": ["SELECT AVG(fastestLapSpeed) FROM results WHERE raceId IN (SELECT raceId FROM races WHERE name = 'Spanish Grand Prix' AND year = 2009)"], "28d64fb7882adf4b5e3f67eb0155fd08f8e0336b": ["SELECT AVG(\n    CAST(SUBSTR(r.fastestLapTime, 1, INSTR(r.fastestLapTime, ':') - 1) AS REAL) * 60\n    + CAST(SUBSTR(r.fastestLapTime, INSTR(r.fastestLapTime, ':') + 1) AS REAL)\n) AS avg_fastest_lap_seconds\nFROM results r\nWHERE r.driverId IN (\n    SELECT d.driverId\n    FROM drivers d\n    WHERE d.forename = 'Lewis' AND d.surname = 'Hamilton'\n)\nAND r.fastestLapTime LIKE '%:%';"], "706088921b6d5edddf4368e722dfe6f93d08a45a": ["SELECT COUNT(DISTINCT d.driverId)\nFROM drivers d\nINNER JOIN lapTimes lt ON d.driverId = lt.driverId\nWHERE d.nationality = 'France' AND lt.milliseconds < 120000"], "5001a49d03b71c836949786beb24314089b760df": ["SELECT COUNT(*) FROM drivers WHERE nationality = 'British' AND strftime('%Y', dob) = '1980'"], "95523f97e8b71e14122e3b4fc0ea9a0c535d4d9a": ["SELECT COUNT(*) FROM drivers WHERE nationality = 'French' AND driverId IN (SELECT driverId FROM lapTimes WHERE milliseconds < 120000)"], "5e1a47f8c7dba10626a07b646c90c8f7efac7b09": ["SELECT races.year, races.name, races.date, races.time\nFROM qualifying\nJOIN drivers ON qualifying.driverId = drivers.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE drivers.dob = (SELECT MAX(dob) FROM drivers)\nORDER BY races.date ASC\nLIMIT 1"], "f37477f443a9d9f5454bd72f5e2771685e9bfd22": ["SELECT COUNT(DISTINCT d.driverId)\nFROM drivers AS d\nJOIN results AS r ON d.driverId = r.driverId\nJOIN races AS ra ON r.raceId = ra.raceId\nJOIN results AS r2 ON d.driverId = r2.driverId\nWHERE ra.name = 'Chinese Grand Prix'\n  AND ra.year = 2008\n  AND r.time IS NOT NULL\n  AND r2.raceId IS NOT NULL"], "6e8a86e4159551aecb9a4f8fcf8e6e7d2a0c3a43": ["SELECT COUNT(*) AS count, c.location, c.lat, c.lng\nFROM circuits c\nINNER JOIN races r ON c.circuitId = r.circuitId\nWHERE c.country = 'Austria'\nGROUP BY c.location, c.lat, c.lng"], "4c56fd47ad5f932b5d62873b092deb4d3a8fe5bc": ["SELECT COUNT(*) FROM drivers WHERE nationality = 'British' AND driverId IN (SELECT driverId FROM drivers WHERE strftime('%Y', dob) = '1980')"], "7648b3066c0af7f87bfdb63c0bbfba9d787e739f": ["SELECT year, name, date, time\nFROM races\nWHERE date = (\n    SELECT MIN(races.date)\n    FROM races\n    WHERE races.raceId IN (\n        SELECT qualifying.raceId\n        FROM qualifying\n        WHERE qualifying.driverId = (\n            SELECT drivers.driverId\n            FROM drivers\n            WHERE drivers.dob = (\n                SELECT MAX(drivers.dob)\n                FROM drivers\n            )\n        )\n    )\n)"], "b3d51334d9e2386c5d54102cd96f22033b4c4db2": ["SELECT SUM(CR.points) AS total_points, C.name, C.nationality\nFROM constructorResults CR\nINNER JOIN races R ON CR.raceId = R.raceId\nINNER JOIN constructors C ON CR.constructorId = C.constructorId\nWHERE R.name = 'Monaco Grand Prix' AND R.year BETWEEN 1980 AND 2010\nGROUP BY C.constructorId, C.name, C.nationality\nORDER BY total_points DESC\nLIMIT 1"], "91c2c605284a846b55cb918dbd25d856e00c9eb0": ["SELECT COUNT(*) FROM drivers WHERE driverId IN (SELECT driverId FROM results WHERE time IS NOT NULL AND raceId IN (SELECT raceId FROM races WHERE year = 2008 AND name = 'Chinese Grand Prix')) AND driverId IN (SELECT driverId FROM results GROUP BY driverId HAVING COUNT(raceId) > 0)"], "3d18c2f7fbea94ea66a441d45bb614d01614a404": ["SELECT d.forename, d.surname\nFROM qualifying q\nINNER JOIN races r ON q.raceId = r.raceId\nINNER JOIN circuits c ON r.circuitId = c.circuitId\nINNER JOIN drivers d ON q.driverId = d.driverId\nWHERE r.year = 2008 AND c.name = 'Marina Bay Street Circuit'\nORDER BY q.q3 ASC\nLIMIT 1"], "23a2f87265da71f6451baa01fd7b94d31c10321f": ["SELECT t.total AS score,\n       (SELECT c.name FROM constructors c WHERE c.constructorId = t.constructorId) AS name,\n       (SELECT c.nationality FROM constructors c WHERE c.constructorId = t.constructorId) AS nationality\nFROM (\n  SELECT cr.constructorId, SUM(cr.points) AS total\n  FROM constructorResults cr\n  WHERE cr.raceId IN (\n    SELECT r.raceId\n    FROM races r\n    WHERE r.name = 'Monaco Grand Prix'\n      AND r.year BETWEEN 1980 AND 2010\n  )\n  GROUP BY cr.constructorId\n  ORDER BY total DESC\n  LIMIT 1\n) t"], "3a26afec0ac27c0e035ab7beae782ba33c2b0019": ["SELECT forename, surname\nFROM drivers\nWHERE driverId IN (\n    SELECT driverId\n    FROM qualifying\n    WHERE raceId IN (\n        SELECT raceId\n        FROM races\n        WHERE year = 2008\n          AND circuitId IN (\n              SELECT circuitId\n              FROM circuits\n              WHERE name = 'Marina Bay Street Circuit'\n          )\n    )\n      AND q3 = (\n          SELECT MIN(q3)\n          FROM qualifying\n          WHERE raceId IN (\n              SELECT raceId\n              FROM races\n              WHERE year = 2008\n                AND circuitId IN (\n                    SELECT circuitId\n                    FROM circuits\n                    WHERE name = 'Marina Bay Street Circuit'\n                )\n          )\n      )\n)"], "a317f8453a99a914aaa0ffac595acd992e4a6ef9": ["SELECT c.constructorRef, c.url\nFROM results res\nINNER JOIN races r ON res.raceId = r.raceId\nINNER JOIN constructors c ON res.constructorId = c.constructorId\nWHERE r.name = 'Singapore Grand Prix' AND r.year = 2009\nORDER BY res.time DESC\nLIMIT 1"], "27b28cc978fb86a2cd9cda80d15beb5b944993c1": ["SELECT d.forename || ' ' || d.surname AS full_name, d.nationality, r.name\nFROM drivers d\nINNER JOIN results res ON res.driverId = d.driverId\nINNER JOIN races r ON r.raceId = res.raceId\nORDER BY d.dob DESC, r.date ASC\nLIMIT 1"], "a570da5b0a6aab7ec6832288901d221f776aef7e": ["SELECT forename, surname, nationality, (SELECT MAX(points) FROM driverStandings WHERE driverStandings.driverId = drivers.driverId) FROM drivers WHERE driverId IN (SELECT driverId FROM driverStandings GROUP BY driverId ORDER BY COUNT(wins) DESC LIMIT 1)"], "0f46bfb2df36891469d349bbb4a1068cf9490227": ["SQL: SELECT T1.constructorRef, T1.url FROM constructors AS T1 WHERE T1.constructorId IN (SELECT T2.constructorId FROM results AS T2 WHERE T2.raceId IN (SELECT T3.raceId FROM races AS T3 WHERE T3.year = 2009 AND T3.name = 'Singapore Grand Prix') AND T2.time = (SELECT MAX(time) FROM results WHERE raceId IN (SELECT raceId FROM races WHERE year = 2009 AND name = 'Singapore Grand Prix')))"], "958d1e2869f863e174e90ec75d3e338a7a3c6306": ["SELECT forename, surname, (SELECT MAX(points) FROM driverStandings) AS points FROM drivers WHERE driverId IN (SELECT driverId FROM driverStandings WHERE points = (SELECT MAX(points) FROM driverStandings))"], "5abf424ed0c66e5c88722fdd28d3a3af15fc34fd": ["SELECT location, lat, lng, (SELECT COUNT(*) FROM races WHERE races.circuitId = circuits.circuitId) FROM circuits WHERE country = 'Austria'"], "4f73cfb6395a9304fab80617d4411e266f085bb7": ["SELECT MIN(lt.time) AS lapRecord\nFROM lapTimes lt\nINNER JOIN races r ON lt.raceId = r.raceId\nINNER JOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.name = 'Austrian Grand Prix Circuit'"], "31e30914b2ebb0f55a90b0d1170681299794dea7": ["SELECT\n  (SELECT d.forename || ' ' || d.surname FROM drivers d WHERE d.dob = (SELECT MAX(dob) FROM drivers)) AS full_name,\n  (SELECT d.nationality FROM drivers d WHERE d.dob = (SELECT MAX(dob) FROM drivers)) AS nationality,\n  (SELECT r.name FROM races r WHERE r.raceId = (SELECT MIN(res.raceId) FROM results res WHERE res.driverId = (SELECT d2.driverId FROM drivers d2 WHERE d2.dob = (SELECT MAX(dob) FROM drivers)))) AS first_race"], "195d72cfe4e00d59858f12420682646accbf9ff5": ["SELECT r.name\nFROM lapTimes lt\nINNER JOIN races r ON lt.raceId = r.raceId\nINNER JOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.name = 'Austrian Grand Prix Circuit'\nORDER BY lt.milliseconds ASC\nLIMIT 1"], "1a2cd13c9192f60ea047a84a9636b63eef5bf235": ["SELECT AVG(lt.milliseconds)\nFROM lapTimes lt\nINNER JOIN races r ON lt.raceId = r.raceId\nINNER JOIN circuits c ON r.circuitId = c.circuitId\nWHERE c.country = 'Italy'"], "f903346d1351c7b99bc3c376993ea115afafff1e": ["SELECT AVG(milliseconds) FROM lapTimes WHERE raceId IN (SELECT raceId FROM races WHERE circuitId IN (SELECT circuitId FROM circuits WHERE country = 'Italy'))"], "862e93ae37f5dc4917a474b588da39e4b5115452": ["SELECT circuits.name, MIN(lapTimes.time) AS lap_record FROM circuits INNER JOIN races ON circuits.circuitId = races.circuitId INNER JOIN lapTimes ON races.raceId = lapTimes.raceId WHERE circuits.country = 'Italy' GROUP BY circuits.name"], "b3e1046521604b5b73998ea82af8439434f4c1c6": ["SELECT c.name AS circuit,\n       (SELECT MIN(r.fastestLapTime)\n        FROM results r\n        WHERE r.raceId IN (SELECT ra.raceId\n                           FROM races ra\n                           WHERE ra.circuitId = c.circuitId)\n          AND r.fastestLapTime IS NOT NULL) AS lapRecord\nFROM circuits c\nWHERE c.country = 'Italy'"], "5e324b7c676989ed8d8fe7e03314898c56a02013": ["SELECT time\nFROM lapTimes\nWHERE raceId IN (\n    SELECT raceId\n    FROM races\n    WHERE circuitId IN (\n        SELECT circuitId\n        FROM circuits\n        WHERE country = 'Austria'\n           OR name LIKE '%Austrian Grand Prix%'\n    )\n)\nORDER BY milliseconds ASC\nLIMIT 1"], "2019f9b6c186d7ba800083c6fc5c80055e0841c2": ["SELECT lt.time\nFROM lapTimes lt\nJOIN races r ON lt.raceId = r.raceId\nJOIN circuits c ON r.circuitId = c.circuitId\nORDER BY lt.milliseconds ASC\nLIMIT 1"], "64af2ed794c0dd9ac377b1cf1a42ff0f34edd2af": ["SELECT time FROM lapTimes WHERE milliseconds = (SELECT MIN(milliseconds) FROM lapTimes)"], "133fbf59e855b3cf869981a5e501f10fbc9a7221": ["SELECT name\nFROM races\nWHERE circuitId IN (SELECT circuitId FROM races WHERE name = 'Austrian Grand Prix')\n  AND raceId IN (\n      SELECT raceId\n      FROM results\n      WHERE fastestLapTime = (\n          SELECT MIN(fastestLapTime)\n          FROM results\n          WHERE raceId IN (\n              SELECT raceId\n              FROM races\n              WHERE circuitId IN (SELECT circuitId FROM races WHERE name = 'Austrian Grand Prix')\n          )\n      )\n  )"], "86d741a6f8926bb7301d736f16cd37251a840a7b": ["SELECT AVG(t.sets_per_year) AS annual_average_sets, (SELECT language FROM foreign_data GROUP BY language ORDER BY COUNT(language) DESC LIMIT 1) AS common_language FROM (SELECT strftime('%Y', releaseDate) AS yr, COUNT(id) AS sets_per_year FROM sets WHERE releaseDate BETWEEN '2012-01-01' AND '2015-12-31' GROUP BY strftime('%Y', releaseDate)) t;", "SELECT AVG(T1.id), T2.language FROM sets AS T1 JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T1.releaseDate BETWEEN '2012-01-01' AND '2015-12-31' GROUP BY T2.language ORDER BY COUNT(T2.language) DESC LIMIT 1", "SELECT AVG(T1.num) , (SELECT language FROM set_translations GROUP BY language ORDER BY COUNT(language) DESC LIMIT 1) FROM (SELECT COUNT(id) AS num FROM sets WHERE releaseDate BETWEEN '2012-01-01' AND '2015-12-31' GROUP BY strftime('%Y', releaseDate)) AS T1"], "8ce4071a1072ddf1f372b9f5e580db9767ed7037": ["SELECT T2.translation FROM cards AS T1 JOIN set_translations AS T2 ON T1.setCode = T2.setCode WHERE T1.name = 'Tendo Ice Bridge' AND T2.language = 'French'"], "4d6d31986e8823a85fced06db957b5648adc4ea2": ["SELECT COUNT(CASE WHEN convertedManaCost = 10 THEN 1 END) * 100.0 / COUNT(convertedManaCost) FROM cards WHERE name = 'Abyssal Horror'"], "fe3abf2675fde68f433b15b24678d40711e49e77": ["SELECT id,\n       (SELECT COUNT(id) FROM cards WHERE isStorySpotlight = 1 AND isTextless = 0) * 100.0 / (SELECT COUNT(id) FROM cards) AS percentage\nFROM cards\nWHERE isStorySpotlight = 1 AND isTextless = 0"], "2bd0229c4716ee168e70a6a3203bceb78ccc23f0": ["This query reads only the `cards` table, with no joins, aggregation, ordering, or limit. It returns the `name` column of every row in `cards` where `cardKingdomFoilId` is not null (i.e., has a value) AND `cardKingdomId` is not null. Rows where either of those two columns is null are excluded, and only the `name` values of the remaining rows are output."], "537e42a399a55c1c1ca70b06db9457b3ff02740a": ["This query reads only the `cards` table (no joins). It keeps exactly those rows where `borderColor` is exactly 'borderless', where `cardKingdomFoilId` has no value (IS NULL), and where `cardKingdomId` has a value (IS NOT NULL). From those rows it returns the `name` column, with no aggregation, ordering, or row limit."], "a3c0f43c18793beaba5e0935aa431edb9da33195": ["From the `cards` table, this selects rows where `faceConvertedManaCost` equals the largest value of `faceConvertedManaCost` found anywhere in the `cards` table (computed by the subquery). No joins, additional filters, grouping, ordering, or row limit are applied. It returns exactly two columns for those rows: `name` and `faceConvertedManaCost`."], "3cc09a9e4ece0a92f7f3db0bbb087d61cdb27964": ["The query reads the cards table and keeps only the rows where frameVersion is exactly '2015' and edhrecRank is less than 100 (both conditions must hold). From those rows, it returns the name column. No joins, grouping, ordering, or row limit is applied."], "c0e30857e5d92ff63599925e48aaa5879eeb8f40": ["Selects the **name** column from the **cards** table (aliased `c`), joining **cards** to **legalities** (aliased `l`) on rows where their `uuid` values are equal. It keeps only rows where the card's `rarity` exactly equals `'mythic'`, the legality row's `status` exactly equals `'Banned'`, and the legality row's `format` exactly equals `'gladiator'`. There is no aggregation, ordering, or limit, so it returns the names of every joined row meeting those three conditions, possibly with duplicates if a card has multiple matching legality rows."], "99acfb320f9963071e640ef3e8215de0f4f983a4": ["Select the `name` column from the `cards` table. Return only rows where `frameVersion` is exactly '2015' and `edhrecRank` is less than 100. No joins, aggregations, ordering, or limits are applied."], "ce7b546a781b5b4f1700f3e2a7db655c535685ea": ["```sql\nSELECT DISTINCT c.name\nFROM cards c\nJOIN foreign_data f ON c.uuid = f.uuid\nWHERE f.language = 'Japanese';\n```"], "25b3d895de593c75ead652279972aebd0c139c5b": ["```sql\nSELECT T1.name, T1.totalSetSize\nFROM sets AS T1\nINNER JOIN set_translations AS T2 ON T1.code = T2.setCode\nWHERE T2.language = 'Italian';\n```"], "126694bedee7d698f3b2051816a657a692da500c": ["```sql\nSELECT COUNT(DISTINCT types) AS num_card_types\nFROM cards\nWHERE artist = 'Aaron Boyd';\n```"], "747c030e493871b14a8265a2c698478c40c95bef": ["```sql\nSELECT promoTypes FROM cards WHERE name = 'Duress';\n```"], "362b09827bc5315eb005b14bbb7f56bde84af0eb": ["```sql\nSELECT name\nFROM cards\nWHERE frameVersion = '2015'\n  AND edhrecRank < 100;\n```"], "37d5eef042a0bac1afdb997eb3dc9bc42297df89": ["```sql\nSELECT keywords FROM cards WHERE name = 'Angel of Mercy';\n```"], "9427435919d980f28a7573ab3190d7047d85c58f": ["```sql\nSELECT c.name, c.artist, c.isPromo\nFROM cards c\nJOIN rulings r ON c.uuid = r.uuid\nGROUP BY c.uuid, c.name, c.artist, c.isPromo\nHAVING COUNT(r.uuid) = (\n    SELECT MAX(cnt)\n    FROM (\n        SELECT COUNT(*) AS cnt\n        FROM rulings\n        GROUP BY uuid\n    ) t\n);\n```"], "6a0a73041d154f7db4a8877b2baed2c89034b42f": ["```sql\nSELECT COUNT(*) FROM cards WHERE power = '*';\n```"], "3121fccda0ee87434ca4713db9c88373458964c6": ["```sql\nSELECT originalType FROM cards WHERE name = 'Ancestor''s Chosen';\n```"], "c71a9cc3e20ecdfc7e9493c9bfd319fb39901f3b": ["```sql\nSELECT T1.language\nFROM foreign_data AS T1\nJOIN cards AS T2 ON T1.uuid = T2.uuid\nWHERE T2.name = 'Annul' AND T2.number = '29';\n```"], "cb89fc56a9839c033dceed3515b5c6bc769ebaf5": ["```sql\nSELECT COUNT(*)\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.status = 'restricted'\n  AND cards.isTextless = 0;\n```"], "170f11730a0493047be44c0bc0c88f9bcd71014c": ["```sql\nSELECT COUNT(DISTINCT cards.id)\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.status = 'restricted'\n  AND cards.isStarter = 1;\n```"], "bd276916b1ca1b31816e57ab857ea9d507047d30": ["```sql\nSELECT DISTINCT cards.artist\nFROM cards\nJOIN foreign_data ON foreign_data.uuid = cards.uuid\nWHERE foreign_data.language = 'Phyrexian';\n```"], "072f64e15690458baffb93ae40cee17eebdc1db6": ["```sql\nSELECT T2.status\nFROM cards AS T1\nJOIN legalities AS T2 ON T1.uuid = T2.uuid\nWHERE T1.name = 'Cloudchaser Eagle';\n```"], "982adfd49d7aabea9cd89390f56a95d599605cd4": ["```sql\nSELECT type FROM cards WHERE name = 'Benalish Knight';\n```"], "507954d9e8e05ac5c2d25879b364cd152204cc24": ["```sql\nSELECT name\nFROM cards\nWHERE artist = 'Aaron Boyd';\n```"], "d0f223ba4a301a1010048d8545fb6c02c5ccd27d": ["```sql\nSELECT COUNT(*) FROM cards WHERE borderColor = 'black' AND availability = 'mtgo';\n```"], "516d42ab87ff775cccb482fb6d5f3f2549e6ccc9": ["```sql\nSELECT COUNT(DISTINCT c.id)\nFROM cards c\nJOIN foreign_data fd ON fd.uuid = c.uuid\nWHERE fd.language = 'German'\n  AND c.isReprint = 1;\n```"], "42954032001ca336b680ff870e177b5e4554fdc3": ["```sql\nSELECT edhrecRank FROM cards WHERE frameVersion = '2015';\n```"], "9db2a01a979534a773ba1018b08c52d3dec76759": ["```sql\nSELECT id\nFROM cards\nWHERE cardKingdomFoilId IS NOT NULL\n  AND cardKingdomId IS NOT NULL;\n```"], "543a488074b68bdfba7c80484ad3036693bc839f": ["```sql\nSELECT id\nFROM cards\nWHERE convertedManaCost = 0;\n```"], "9921df4682a70ab2512356f43c5a2b565599ed87": ["```sql\nSELECT COUNT(CASE WHEN borderColor = 'borderless' THEN 1 END) * 100.0 / COUNT(id) AS percentage\nFROM cards;\n```"], "a923e07860941df8dd7b62652c1b48034f88b68e": ["```sql\nSELECT DISTINCT l.uuid, fd.language\nFROM legalities AS l\nJOIN foreign_data AS fd ON l.uuid = fd.uuid\nWHERE l.format = 'legacy';\n```"], "5f45a322fdfb427efae0bfa6c49f6a45f9af539b": ["```sql\nSELECT COUNT(*) \nFROM cards \nWHERE originalType = 'Summon - Angel' \n  AND subtypes != 'Angel';\n```"], "faea4bd1decf95f0f7d59abb0f13150b026546f1": ["```sql\nSELECT rulings.text\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.name = 'Beacon of Immortality';\n```"], "5e9fd4da873ce8b1e22ae279a171b3b427eb7703": ["```sql\nSELECT COUNT(*)\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.borderColor = 'borderless'\n  AND foreign_data.language = 'Russian';\n```"], "ced5dd1ede0676a3f811e044b539275adfafe768": ["```sql\nSELECT c.colors, l.format\nFROM cards c\nJOIN legalities l ON c.uuid = l.uuid\nWHERE c.id BETWEEN 1 AND 20;\n```"], "c701a9232e27137a91cdd02416f60deb32cbf663": ["```sql\nSELECT cards.name, rulings.date\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.rarity = 'uncommon'\nORDER BY rulings.date ASC\nLIMIT 3;\n```"], "73accebf8d11a632ee7275078e3f788a52f7aada": ["```sql\nSELECT c.name, r.date\nFROM cards c\nJOIN rulings r ON c.uuid = r.uuid\nWHERE c.originalType = 'Creature - Elf';\n```"], "caf4a1430679817f130699e954fda63ad3a2ac96": ["```sql\nSELECT COUNT(id)\nFROM cards\nWHERE artist = 'UDON' AND availability = 'mtgo' AND hand = -1\n```"], "40ceca62ccb3b411667f92246dcc1c105d32e940": ["```sql\nSELECT COUNT(T1.name) AS num_cards, T2.status\nFROM cards AS T1\nINNER JOIN legalities AS T2 ON T1.uuid = T2.uuid\nWHERE T1.frameVersion = 'future' AND T2.status = 'legal';\n```"], "f19f96e6c64c24392f492b5ea2885c4ad81e6856": ["```sql\nSELECT COUNT(*) FROM cards WHERE frameVersion = '1993' AND availability = 'paper' AND hasContentWarning = 1;\n```"], "6426dd5374ad761e034e334cb4f1a22bd7ab9fff": ["```sql\nSELECT SUM(manaCost) FROM cards WHERE artist = 'Rob Alexander';\n```"], "6c7265d348ce80ef0f25e0e3e2bdd410b5027b98": ["```sql\nSELECT DISTINCT cards.name, foreign_data.language\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.setCode = '10E' AND cards.convertedManaCost = 5;\n```"]}