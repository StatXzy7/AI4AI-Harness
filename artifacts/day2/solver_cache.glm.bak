e FROM sets WHERE releaseDate = '2017-07-14'", "SELECT code FROM sets WHERE releaseDate = '2017-07-14'"], "5979f7a2a029cfc64929eb818d14efcfc068f732": ["SELECT 100.0 * SUM(CASE WHEN cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*) FROM cards JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Coldsnap'", "SELECT SUM(cardKingdomFoilId IS NOT NULL AND cardKingdomId IS NOT NULL) * 100.0 / COUNT(*) FROM cards JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Coldsnap';", "SELECT SUM(CASE WHEN cards.cardKingdomFoilId IS NOT NULL AND cards.cardKingdomId IS NOT NULL THEN 1 ELSE 0 END) * 100.0 / COUNT(*) FROM cards JOIN sets ON cards.setCode = sets.code WHERE sets.name = 'Coldsnap';"], "3edd9eb1a4bc9b0832e2c7696ab51e4086b5773b": ["SELECT type FROM sets WHERE name = 'From the Vault: Lore'", "SELECT type FROM sets WHERE name = 'From the Vault: Lore'", "SELECT type FROM sets WHERE name = 'From the Vault: Lore'"], "505a5b4bd1d6b1fc75295eafb21c0736422f8894": ["SELECT parentCode FROM sets WHERE name = 'Commander 2014 Oversized';", "SELECT parentCode FROM sets WHERE name = 'Commander 2014 Oversized';", "SELECT parentCode FROM sets WHERE name = 'Commander 2014 Oversized';"], "289341334297682137ca53267448055e368a0bb5": ["SELECT T1.type FROM sets AS T1 JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.translation = 'Huiti\u00e8me \u00e9dition'", "SELECT s.type FROM sets AS s JOIN set_translations AS st ON s.code = st.setCode WHERE st.translation = 'Huiti\u00e8me \u00e9dition'", "SELECT T1.type FROM sets AS T1 JOIN set_translations AS T2 ON T1.code = T2.setCode WHERE T2.translation = 'Huiti\u00e8me \u00e9dition'"], "1e12f02157844c504e45dfa205d45253bd1aebd0": ["SELECT T1.releaseDate FROM sets AS T1 JOIN cards AS T2 ON T1.code = T2.setCode WHERE T2.name = 'Evacuation'", "SELECT sets.releaseDate FROM cards JOIN sets ON cards.setCode = sets.code WHERE cards.name = 'Evacuation'", "SELECT T2.releaseDate FROM cards AS T1 JOIN s