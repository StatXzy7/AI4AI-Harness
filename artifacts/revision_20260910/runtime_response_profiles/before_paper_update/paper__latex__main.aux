\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Phase-II confirmatory design} (frozen protocol). Left: database-level contamination isolation (the two development databases are banned wholesale; evaluation uses nine databases, with the disclosed 18-item smoke exception). Middle: the $2{\times }2$ factorial (strategy forcing $\times $ conformance gate) with a common attempt cap (realized costs differ), plus the open-mechanism arm II-E. Right: the three-layer admission pipeline (neutral validity $\rightarrow $ counterfactual conformance $\rightarrow $ non-vacuity vs.\ bare).}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:design}{{2}{7}{\textbf {Phase-II confirmatory design} (frozen protocol). Left: database-level contamination isolation (the two development databases are banned wholesale; evaluation uses nine databases, with the disclosed 18-item smoke exception). Middle: the $2{\times }2$ factorial (strategy forcing $\times $ conformance gate) with a common attempt cap (realized costs differ), plus the open-mechanism arm II-E. Right: the three-layer admission pipeline (neutral validity $\rightarrow $ counterfactual conformance $\rightarrow $ non-vacuity vs.\ bare)}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Corrected primary analysis of the original intervention.} Means over 18 builder--seed cells on 1{,}169 questions. Bare is included in both the oracle and best-fixed comparator. The CI incorporates task and generation-seed variation, conditional on six fixed builders and the archived execution records. The sign-flip reference test conditions on the observed tasks and assumes symmetric cell contrasts.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:primary}{{2}{7}{\textbf {Corrected primary analysis of the original intervention.} Means over 18 builder--seed cells on 1{,}169 questions. Bare is included in both the oracle and best-fixed comparator. The CI incorporates task and generation-seed variation, conditional on six fixed builders and the archived execution records. The sign-flip reference test conditions on the observed tasks and assumes symmetric cell contrasts}{table.2}{}}
