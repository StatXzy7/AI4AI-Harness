\newlabel{fig:results}{{3}{8}{\textbf {Versioned corrected reanalysis.} Left: full-set D$-$A cell contrasts and the pooled unadjusted 95\% interval. Right: four-arm headroom on the same core-400 tasks with a shared bare baseline. Both axes use percentage points. No significance stars are used; raw and adjusted $p$-values appear in Table~\ref {tab:factorial}}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Corrected core-400 factorial reanalysis.} Gate is $[(B-A)+(D-C)]/2$, strategy is $[(C-A)+(D-B)]/2$, and interaction is $(D-C)-(B-A)$. CIs are unadjusted database/task/seed bootstrap intervals. Raw $p$-values use two-sided cell sign flips; Holm adjusts the three secondary tests. The two procedures address different sources of variation.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:factorial}{{3}{8}{\textbf {Corrected core-400 factorial reanalysis.} Gate is $[(B-A)+(D-C)]/2$, strategy is $[(C-A)+(D-B)]/2$, and interaction is $(D-C)-(B-A)$. CIs are unadjusted database/task/seed bootstrap intervals. Raw $p$-values use two-sided cell sign flips; Holm adjusts the three secondary tests. The two procedures address different sources of variation}{table.3}{}}
