\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Phase-II confirmatory design} (frozen protocol). Left: database-level contamination isolation (the two development databases are banned wholesale; evaluation uses nine databases never opened during development). Middle: the $2{\times }2$ factorial (strategy forcing $\times $ conformance gate) with equal raw budgets, plus the open-mechanism arm II-E. Right: the three-layer admission pipeline (neutral validity $\rightarrow $ counterfactual conformance $\rightarrow $ non-vacuity vs.\ bare).}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:design}{{2}{7}{\textbf {Phase-II confirmatory design} (frozen protocol). Left: database-level contamination isolation (the two development databases are banned wholesale; evaluation uses nine databases never opened during development). Middle: the $2{\times }2$ factorial (strategy forcing $\times $ conformance gate) with equal raw budgets, plus the open-mechanism arm II-E. Right: the three-layer admission pipeline (neutral validity $\rightarrow $ counterfactual conformance $\rightarrow $ non-vacuity vs.\ bare)}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Primary result.} Bare-inclusive oracle headroom per arm and the paired D$-$A contrast, pooled over 6 builders $\times $ 3 seeds on the 1{,}169-question confirmatory set (nine databases never opened during development), official BIRD judge. The CI spans zero: \textbf  {the combined intervention shows no clear improvement}. Per-cell values are in Figure~\ref {fig:results} (left).}}{7}{table.2}\protected@file@percent }
\newlabel{tab:primary}{{2}{7}{\textbf {Primary result.} Bare-inclusive oracle headroom per arm and the paired D$-$A contrast, pooled over 6 builders $\times $ 3 seeds on the 1{,}169-question confirmatory set (nine databases never opened during development), official BIRD judge. The CI spans zero: \textbf {the combined intervention shows no clear improvement}. Per-cell values are in Figure~\ref {fig:results} (left)}{table.2}{}}
