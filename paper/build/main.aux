\newlabel{fig:results}{{3}{8}{\textbf {Confirmatory results.} Left: per-cell D$-$A headroom deltas (sorted; green = D better, red = A better) with the pooled 95\% CI band. Right: factorial arm means on the identical core-400 items; the conformance gate's negative main effect is starred (CI excludes zero). Both panels derive from the frozen analysis scripts}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Confirmatory secondaries}, 18 quad cells, all four arms on the identical 400-item core. The gate main effect is the only contrast whose CI excludes zero --- on the negative side.}}{8}{table.3}\protected@file@percent }
