\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase-I discovery audit. Each point is a pair among 14 harnesses on 60 tasks. Source-code similarity and outcome disagreement are distinct measurements; $\rho =-0.01$ is descriptive, and 36/91 pairs are outcome identical.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:phenomenon}{{1}{3}{Phase-I discovery audit. Each point is a pair among 14 harnesses on 60 tasks. Source-code similarity and outcome disagreement are distinct measurements; $\rho =-0.01$ is descriptive, and 36/91 pairs are outcome identical}{figure.1}{}}
